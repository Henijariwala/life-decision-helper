<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>History - Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream: #FAF7F2;
      --beige: #E8DCC4;
      --beige-dark: #D4C5A9;
      --brown: #8B7355;
      --brown-dark: #6B5744;
      --white: #FFFFFF;
      --text: #3E3429;
      --text-light: #7D6E5C;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Work Sans', sans-serif;
      background: var(--cream);
      min-height: 100vh;
    }

    .header {
      background: var(--white);
      border-bottom: 1px solid var(--beige);
      padding: 1.2rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 1px 3px rgba(139, 115, 85, 0.05);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .logo {
      font-size: 1.8rem;
    }

    .header h1 {
      font-family: 'Cormorant Garamond', serif;
      color: var(--brown-dark);
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
    }

    .btn {
      padding: 0.6rem 1.2rem;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      font-family: 'Work Sans', sans-serif;
    }

    .btn-secondary {
      background: transparent;
      color: var(--brown);
      border: 1.5px solid var(--beige-dark);
    }

    .btn-secondary:hover {
      background: var(--cream);
      border-color: var(--brown);
    }

    .btn-new-chat {
      background: var(--brown);
      color: var(--white);
      border: none;
    }

    .btn-new-chat:hover {
      background: var(--brown-dark);
      transform: translateY(-1px);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
    }

    .page-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .page-title {
      font-family: 'Cormorant Garamond', serif;
      color: var(--brown-dark);
      font-size: 3rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }

    .page-subtitle {
      color: var(--text-light);
      font-size: 1.05rem;
      font-weight: 300;
      letter-spacing: 0.03em;
    }

    .history-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 1.5rem;
    }

    .chat-card {
      background: var(--white);
      border-radius: 2px;
      padding: 1.8rem;
      border: 1px solid var(--beige);
      box-shadow: 0 1px 3px rgba(139, 115, 85, 0.05);
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .chat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--beige-dark), var(--brown), var(--beige-dark));
    }

    .chat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 4px 12px rgba(139, 115, 85, 0.12);
      border-color: var(--beige-dark);
    }

    .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.2rem;
    }

    .chat-icon {
      font-size: 2rem;
    }

    .chat-date {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      font-size: 0.75rem;
      color: var(--text-light);
    }

    .chat-date-day {
      font-weight: 600;
      color: var(--brown);
      font-size: 0.85rem;
      letter-spacing: 0.02em;
    }

    .chat-date-time {
      margin-top: 0.25rem;
    }

    .chat-preview {
      color: var(--text);
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.2rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      min-height: 4.5em;
    }

    .chat-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 1rem;
      border-top: 1px solid var(--beige);
    }

    .chat-message-count {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-light);
    }

    .chat-actions {
      display: flex;
      gap: 0.5rem;
    }

    .btn-icon {
      background: transparent;
      border: none;
      cursor: pointer;
      font-size: 1.1rem;
      padding: 0.4rem;
      border-radius: 2px;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
    }

    .btn-icon:hover {
      background: var(--cream);
      color: var(--brown);
    }

    .btn-delete:hover {
      background: #FEF2F2;
      color: #DC2626;
    }

    .empty-state {
      text-align: center;
      padding: 5rem 2rem;
      background: var(--white);
      border-radius: 2px;
      border: 1px solid var(--beige);
      box-shadow: 0 1px 3px rgba(139, 115, 85, 0.05);
    }

    .empty-state-icon {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    .empty-state h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      color: var(--brown-dark);
      margin-bottom: 0.75rem;
      font-weight: 600;
    }

    .empty-state p {
      font-size: 1rem;
      color: var(--text-light);
      margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
      .history-grid {
        grid-template-columns: 1fr;
      }

      .page-title {
        font-size: 2.5rem;
      }

      .header {
        padding: 1rem 1.5rem;
      }

      .header h1 {
        font-size: 1.2rem;
      }

      .btn {
        font-size: 0.8rem;
        padding: 0.5rem 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-left">
      <span class="logo">📚</span>
      <h1>Your History</h1>
    </div>
    <div class="header-actions">
      <a href="/chat" class="btn btn-new-chat">
        <span>+</span> New Chat
      </a>
      <form action="/logout" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-secondary">
          Logout
        </button>
      </form>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1 class="page-title">Past Conversations</h1>
      <p class="page-subtitle">Review your journey to clarity</p>
    </div>

    <% if (decisions && decisions.length > 0) { %>
      <div class="history-grid">
        <% decisions.forEach(function(decision) { %>
          <div class="chat-card" onclick="openChat('<%= decision.id %>')">
            <div class="chat-header">
              <div class="chat-icon">💭</div>
              <div class="chat-date">
                <% if (decision.createdAt) { %>
                  <div class="chat-date-day">
                    <%= new Date(decision.createdAt).toLocaleDateString('en-IN', { 
                      month: 'short', 
                      day: 'numeric', 
                      year: 'numeric',
                      timeZone: 'Asia/Kolkata'
                    }) %>
                  </div>
                  <div class="chat-date-time">
                    <%= new Date(decision.createdAt).toLocaleTimeString('en-IN', { 
                      hour: '2-digit', 
                      minute: '2-digit',
                      hour12: true,
                      timeZone: 'Asia/Kolkata'
                    }) %>
                  </div>
                <% } else { %>
                  <div class="chat-date-day">Recent</div>
                <% } %>
              </div>
            </div>
            
            <div class="chat-preview">
              <%= decision.preview || 'No preview available' %>
            </div>
            
            <div class="chat-meta">
              <div class="chat-message-count">
                <span>💬</span>
                <span><%= (decision.messages && decision.messages.length) || 0 %> messages</span>
              </div>
              
              <div class="chat-actions" onclick="event.stopPropagation()">
                <button class="btn-icon btn-delete" onclick="deleteChat('<%= decision.id %>')" title="Delete">
                  🗑️
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">🧭</div>
        <h2>No Conversations Yet</h2>
        <p>Your journey begins with a single question</p>
        <a href="/chat" class="btn btn-new-chat">
          <span>+</span> Start Your First Chat
        </a>
      </div>
    <% } %>
  </div>

  <script>
    function openChat(chatId) {
      window.location.href = `/chat?chatId=${chatId}`;
    }

    async function deleteChat(chatId) {
      if (!confirm('Are you sure you want to delete this conversation?')) {
        return;
      }

      try {
        const response = await fetch(`/chat/${chatId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await response.json();

        if (data.success) {
          window.location.reload();
        } else {
          alert('Failed to delete conversation');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('Failed to delete conversation. Please try again.');
      }
    }
  </script>
</body>
</html>
