
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Decision Chat - Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #2D5F5D;
      --primary-light: #3D7F7D;
      --accent: #F4A261;
      --text: #1A3130;
      --text-light: #5A7877;
      --bg: #FDFCF8;
      --card-bg: #FFFFFF;
      --error: #E76F51;
      --success: #52B788;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      background-image: 
        radial-gradient(circle at 20% 80%, rgba(45, 95, 93, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(244, 162, 97, 0.03) 0%, transparent 50%);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--card-bg);
      border-radius: 20px;
      box-shadow: 
        0 4px 6px rgba(45, 95, 93, 0.05),
        0 10px 20px rgba(45, 95, 93, 0.08);
      overflow: hidden;
      height: 90vh;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(45, 95, 93, 0.1);
    }

    .header {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      padding: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-left h2 {
      font-family: 'Fraunces', serif;
      font-size: 24px;
      margin-bottom: 4px;
    }

    .header-left p {
      font-size: 14px;
      opacity: 0.9;
    }

    .header-actions {
      display: flex;
      gap: 12px;
    }

    .btn {
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-block;
      font-size: 14px;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.2);
      color: white;
      backdrop-filter: blur(10px);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
    }

    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      background: var(--bg);
    }

    .message {
      margin-bottom: 20px;
      display: flex;
      gap: 12px;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      flex-direction: row-reverse;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 20px;
      box-shadow: 0 2px 8px rgba(45, 95, 93, 0.1);
    }

    .message.user .avatar {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    }

    .message.assistant .avatar {
      background: white;
      border: 2px solid var(--primary);
    }

    .bubble {
      max-width: 70%;
      padding: 14px 18px;
      border-radius: 16px;
      line-height: 1.6;
      box-shadow: 0 2px 8px rgba(45, 95, 93, 0.08);
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .message.user .bubble {
      background: var(--primary);
      color: white;
      border-bottom-right-radius: 4px;
    }

    .message.assistant .bubble {
      background: white;
      color: var(--text);
      border: 1px solid rgba(45, 95, 93, 0.1);
      border-bottom-left-radius: 4px;
    }

    .message.assistant .bubble.error {
      background: #fff5f5;
      border-color: #feb2b2;
      color: var(--error);
    }

    .meta {
      font-size: 11px;
      color: var(--text-light);
      margin-top: 6px;
      padding: 0 4px;
    }

    .input-area {
      padding: 24px;
      background: white;
      border-top: 1px solid rgba(45, 95, 93, 0.1);
    }

    .input-container {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
    }

    input[type="text"] {
      flex: 1;
      padding: 14px 20px;
      border: 2px solid rgba(45, 95, 93, 0.15);
      border-radius: 12px;
      font-size: 15px;
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: all 0.2s;
      background: var(--bg);
    }

    input[type="text"]:focus {
      border-color: var(--primary);
      background: white;
      box-shadow: 0 0 0 4px rgba(45, 95, 93, 0.05);
    }

    .btn-primary {
      padding: 14px 28px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-primary:hover {
      background: var(--primary-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(45, 95, 93, 0.25);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .bottom-links {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
    }

    .link {
      color: var(--primary);
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .link:hover {
      color: var(--primary-light);
      text-decoration: underline;
    }

    .empty-state {
      text-align: center;
      padding: 80px 20px;
      color: var(--text-light);
    }

    .empty-state-icon {
      font-size: 64px;
      margin-bottom: 16px;
      opacity: 0.6;
    }

    .empty-state h3 {
      font-family: 'Fraunces', serif;
      font-size: 24px;
      margin-bottom: 8px;
      color: var(--text);
    }

    .empty-state p {
      font-size: 16px;
    }

    .typing-indicator {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 12px 16px;
      background: white;
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      width: fit-content;
      box-shadow: 0 2px 8px rgba(45, 95, 93, 0.08);
    }

    .typing-indicator.active {
      display: flex;
    }

    .typing-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--text-light);
      animation: typing 1.4s infinite;
    }

    .typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typing {
      0%, 60%, 100% {
        transform: translateY(0);
        opacity: 0.4;
      }
      30% {
        transform: translateY(-10px);
        opacity: 1;
      }
    }

    @media (max-width: 768px) {
      body {
        padding: 0;
      }

      .container {
        height: 100vh;
        border-radius: 0;
      }
      
      .bubble {
        max-width: 85%;
      }

      .header-actions {
        flex-direction: column;
        gap: 8px;
      }

      .btn {
        padding: 8px 16px;
        font-size: 13px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="header-left">
        <h2>🧭 Decision Chat</h2>
        <p>AI-powered guidance for your important decisions</p>
      </div>
      <div class="header-actions">
        <a href="/history" class="btn btn-secondary">📚 History</a>
        <a href="/admin" class="btn btn-secondary">⚙️ Admin</a>
      </div>
    </div>

    <div class="messages" id="messages">
      <% if (messages.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">👋</div>
          <h3>Welcome to Decision Chat!</h3>
          <p>Ask me anything about your decisions, goals, or dilemmas.</p>
          <p style="margin-top: 12px; font-size: 14px;">Every conversation is automatically saved.</p>
        </div>
      <% } else { %>
        <% messages.forEach(msg => { %>
          <div class="message <%= msg.role %>">
            <div class="avatar">
              <%= msg.role === 'user' ? '👤' : '🤖' %>
            </div>
            <div>
              <div class="bubble <%= msg.isError ? 'error' : '' %>">
                <%= msg.text %>
              </div>
              <% if (msg.timestamp) { %>
                <div class="meta"><%= msg.timestamp %></div>
              <% } %>
            </div>
          </div>
        <% }) %>
        
        <!-- Typing indicator (hidden by default) -->
        <div class="message assistant" id="typingIndicator">
          <div class="avatar">🤖</div>
          <div class="typing-indicator">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
          </div>
        </div>
      <% } %>
    </div>

    <div class="input-area">
      <form method="POST" action="/chat" id="chatForm">
        <div class="input-container">
          <input 
            type="text" 
            name="message" 
            placeholder="Type your message..." 
            required 
            autocomplete="off"
            id="messageInput"
          />
          <!-- FIXED: Properly escape JSON for HTML attribute -->
          <input type="hidden" name="messages" id="messagesInput" />
          <input type="hidden" name="chatId" value="<%= chatId %>" id="chatIdInput" />
          <button type="submit" class="btn-primary" id="submitBtn">
            ✉️ Send
          </button>
        </div>
      </form>
      
      <div class="bottom-links">
        <a href="/history" class="link">📚 View chat history</a>
        <a href="#" class="link" onclick="startNewChat(event)">✨ Start new chat</a>
      </div>
    </div>
  </div>

  <script>
    // FIXED: Properly handle messages data in JavaScript
    const messagesData = <%- JSON.stringify(messages) %>;
    document.getElementById('messagesInput').value = JSON.stringify(messagesData);

    // Auto-scroll to bottom
    const messagesDiv = document.getElementById('messages');
    if (messagesDiv) {
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    // Focus input
    const messageInput = document.getElementById('messageInput');
    if (messageInput) {
      messageInput.focus();
    }

    // Form submission handling
    const form = document.getElementById('chatForm');
    const submitBtn = document.getElementById('submitBtn');
    const typingIndicator = document.getElementById('typingIndicator');
    let isSubmitting = false;
    
    if (form) {
      form.addEventListener('submit', function(e) {
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }
        
        // FIXED: Check if typing indicator exists before accessing
        if (typingIndicator) {
          const indicator = typingIndicator.querySelector('.typing-indicator');
          if (indicator) {
            indicator.classList.add('active');
            if (messagesDiv) {
              messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }
          }
        }
        
        isSubmitting = true;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = '⏳ Sending...';
        }
        if (messageInput) {
          messageInput.disabled = true;
        }
      });
    }

    // Start new chat
    function startNewChat(e) {
      e.preventDefault();
      
      if (confirm('Start a new chat? Current chat will be saved.')) {
        // Clear the chatId to start fresh
        const chatIdInput = document.getElementById('chatIdInput');
        if (chatIdInput) {
          chatIdInput.value = '';
        }
        window.location.href = '/chat';
      }
    }

    // Smooth scroll animation
    if (messagesDiv) {
      messagesDiv.style.scrollBehavior = 'smooth';
    }

    // Auto-resize textarea on mobile
    if (window.innerWidth <= 768 && messageInput) {
      messageInput.style.fontSize = '16px'; // Prevents iOS zoom
    }

    // Log chat info to console
    console.log('💬 Chat loaded');
    console.log('📝 Messages:', messagesData.length);
    console.log('🆔 Chat ID:', '<%= chatId %>');
  </script>
</body>
</html>