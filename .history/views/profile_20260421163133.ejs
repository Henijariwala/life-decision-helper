<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile — Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root{--ivory:#FFFFF0;--ivory-dark:#F5F5DC;--green:#2D5016;--green-light:#3D6B23;--sage:#8BA888;--sage-light:rgba(139,168,136,.15);--white:#FFFFFF;--text:#1A2E0F;--text-light:#5A6B52;--danger:#DC2626;--danger-bg:#FEF2F2;--success:#16A34A;--success-bg:#F0FDF4;}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'DM Sans',sans-serif;background:var(--ivory);min-height:100vh;}

    /* ══ TOPBAR ══ */
    .topbar{background:var(--white);border-bottom:1px solid rgba(139,168,136,.25);padding:0 2rem;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;box-shadow:0 1px 16px rgba(45,80,22,.05);animation:topIn .5s cubic-bezier(.22,1,.36,1) both;}
    @keyframes topIn{from{opacity:0;transform:translateY(-100%);}to{opacity:1;transform:translateY(0);}}
    .tl{display:flex;align-items:center;gap:.75rem;}
    .tlogo{width:34px;height:34px;background:var(--green);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1rem;transition:transform .35s cubic-bezier(.34,1.56,.64,1);cursor:default;}
    .tlogo:hover{transform:rotate(12deg) scale(1.12);}
    .ttitle{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:600;color:var(--green);}
    .ta{display:flex;align-items:center;gap:.5rem;}
    .nb{display:inline-flex;align-items:center;gap:.4rem;padding:.45rem 1rem;border-radius:6px;font-size:.78rem;font-weight:500;cursor:pointer;transition:all .2s;text-decoration:none;font-family:'DM Sans',sans-serif;letter-spacing:.02em;border:none;white-space:nowrap;}
    .ng{background:transparent;color:var(--text-light);border:1px solid transparent;}
    .ng:hover{background:var(--ivory);color:var(--green);border-color:rgba(139,168,136,.4);}
    .np{background:var(--green);color:var(--ivory);}
    .np:hover{background:var(--green-light);transform:translateY(-1px);box-shadow:0 4px 12px rgba(45,80,22,.2);}

    /* ══ HERO ══ */
    .hero{background:var(--green);position:relative;overflow:hidden;padding:4.5rem 2rem 5rem;}
    .hero-mesh{position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(ellipse 55% 70% at 15% 40%,rgba(139,168,136,.22) 0%,transparent 65%),
                 radial-gradient(ellipse 45% 55% at 85% 60%,rgba(255,255,240,.07) 0%,transparent 65%);
      animation:meshShift 10s ease-in-out infinite alternate;}
    @keyframes meshShift{from{opacity:.8;transform:scale(1);}to{opacity:1;transform:scale(1.05);}}
    .hero-ring{position:absolute;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);border:1px solid rgba(139,168,136,.12);animation:expandRing linear infinite;}
    .hr1{width:300px;height:300px;animation-duration:6s;animation-delay:0s;}
    .hr2{width:500px;height:500px;border-color:rgba(139,168,136,.07);animation-duration:6s;animation-delay:1.5s;}
    .hr3{width:750px;height:750px;border-color:rgba(139,168,136,.04);animation-duration:6s;animation-delay:3s;}
    @keyframes expandRing{0%{opacity:0;transform:translate(-50%,-50%) scale(.5);}40%{opacity:1;}100%{opacity:0;transform:translate(-50%,-50%) scale(1.4);}}

    /* Floating particles */
    .particles{position:absolute;inset:0;pointer-events:none;z-index:1;}
    .particle{position:absolute;border-radius:50%;background:rgba(139,168,136,.35);animation:floatP linear infinite;}
    @keyframes floatP{0%{opacity:0;transform:translateY(0) scale(1);}15%{opacity:1;}85%{opacity:.4;}100%{opacity:0;transform:translateY(-120px) scale(.3);}}

    .hero-content{position:relative;z-index:3;text-align:center;display:flex;flex-direction:column;align-items:center;}

    /* Avatar with ring */
    .avatar-wrap{position:relative;margin-bottom:1.4rem;animation:avatarIn .7s cubic-bezier(.34,1.56,.64,1) .1s both;}
    @keyframes avatarIn{from{opacity:0;transform:scale(.5);}to{opacity:1;transform:scale(1);}}
    .avatar-ring{position:absolute;inset:-6px;border-radius:50%;border:1.5px solid rgba(139,168,136,.35);animation:spinRing 12s linear infinite;}
    .avatar-ring-2{position:absolute;inset:-12px;border-radius:50%;border:1px solid rgba(139,168,136,.15);animation:spinRing 20s linear infinite reverse;}
    @keyframes spinRing{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
    .avatar{width:88px;height:88px;background:linear-gradient(135deg,rgba(139,168,136,.3),rgba(45,80,22,.4));border:2px solid rgba(139,168,136,.5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-size:2.4rem;font-weight:400;color:var(--ivory);position:relative;z-index:2;box-shadow:0 8px 32px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.1);}

    /* Completeness pill */
    .complete-pill{display:inline-flex;align-items:center;gap:.5rem;padding:.3rem .85rem;background:rgba(139,168,136,.12);border:1px solid rgba(139,168,136,.25);border-radius:100px;margin-bottom:1rem;animation:fadeDown .6s cubic-bezier(.22,1,.36,1) .3s both;}
    @keyframes fadeDown{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:translateY(0);}}
    .complete-bar{width:60px;height:3px;background:rgba(139,168,136,.25);border-radius:3px;overflow:hidden;}
    .complete-fill{height:100%;background:var(--sage);border-radius:3px;transition:width .8s cubic-bezier(.22,1,.36,1);}
    .complete-text{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--sage);letter-spacing:.08em;text-transform:uppercase;}

    .hero-name{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,3.5vw,3rem);font-weight:300;color:var(--ivory);letter-spacing:-.02em;line-height:1.1;margin-bottom:.5rem;overflow:hidden;animation:nameReveal .8s cubic-bezier(.22,1,.36,1) .35s both;}
    @keyframes nameReveal{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}
    .hero-email{font-family:'DM Mono',monospace;font-size:.73rem;color:rgba(139,168,136,.75);letter-spacing:.09em;margin-bottom:.6rem;animation:fadeUp .7s ease .45s both;}
    .hero-bio{font-size:.88rem;color:rgba(255,255,240,.45);font-weight:300;line-height:1.7;max-width:380px;font-style:italic;animation:fadeUp .7s ease .55s both;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}

    /* ══ MAIN ══ */
    .main{max-width:820px;margin:0 auto;padding:2.5rem 1.5rem 4rem;}

    /* ── Stats ── */
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2.5rem;}
    .stat{background:var(--white);border:1px solid rgba(139,168,136,.25);border-radius:12px;padding:1.6rem 1.2rem;text-align:center;position:relative;overflow:hidden;cursor:default;transition:transform .25s,box-shadow .25s;animation:statIn .6s cubic-bezier(.22,1,.36,1) both;}
    .stat:nth-child(1){animation-delay:.15s;}.stat:nth-child(2){animation-delay:.25s;}.stat:nth-child(3){animation-delay:.35s;}
    @keyframes statIn{from{opacity:0;transform:translateY(16px) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}
    .stat:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(45,80,22,.1);}
    .stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2.5px;background:linear-gradient(90deg,var(--sage),var(--green),var(--sage));animation:shimmer 3s ease-in-out infinite;}
    @keyframes shimmer{0%,100%{opacity:.5;}50%{opacity:1;}}
    .stat-icon{font-size:1.3rem;margin-bottom:.6rem;display:block;}
    .stat-val{font-family:'Cormorant Garamond',serif;font-size:2.6rem;font-weight:400;color:var(--green);line-height:1;margin-bottom:.3rem;}
    .stat-lbl{font-size:.68rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.1em;font-family:'DM Mono',monospace;}

    /* ── Section label ── */
    .section-label{display:flex;align-items:center;gap:.75rem;margin-bottom:1.25rem;animation:fadeUp .6s ease .3s both;}
    .section-label-line{flex:1;height:1px;background:rgba(139,168,136,.25);}
    .section-label-text{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--text-light);letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;}

    /* ── Card ── */
    .card{background:var(--white);border:1px solid rgba(139,168,136,.25);border-radius:12px;overflow:hidden;margin-bottom:1.25rem;animation:cardIn .65s cubic-bezier(.22,1,.36,1) both;}
    .card:nth-of-type(1){animation-delay:.2s;}.card:nth-of-type(2){animation-delay:.32s;}
    @keyframes cardIn{from{opacity:0;transform:translateY(18px) scale(.98);}to{opacity:1;transform:translateY(0) scale(1);}}
    .card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--sage),var(--green));transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.22,1,.36,1);}
    .card{position:relative;}
    .card:focus-within::before{transform:scaleX(1);}

    .card-header{padding:1.4rem 1.75rem;border-bottom:1px solid rgba(139,168,136,.18);display:flex;align-items:center;gap:.75rem;}
    .card-icon{width:36px;height:36px;background:var(--ivory);border:1px solid rgba(139,168,136,.28);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.95rem;transition:transform .3s,background .3s;}
    .card:focus-within .card-icon{background:var(--sage-light);transform:rotate(8deg) scale(1.08);}
    .card-title{font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:400;color:var(--green);}
    .card-body{padding:1.75rem;}

    /* ── Form fields ── */
    .field{margin-bottom:1.35rem;}
    .field-label{display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;}
    .field-label-text{font-size:.71rem;font-weight:500;color:var(--text-light);letter-spacing:.08em;text-transform:uppercase;transition:color .2s;}
    .field:focus-within .field-label-text{color:var(--green);}
    .field-required{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--sage);letter-spacing:.05em;}
    .char-count{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--text-light);transition:color .2s;}
    .char-count.warn{color:#f59e0b;}
    .char-count.full{color:var(--danger);}

    .input-wrap{position:relative;}
    .field-input{width:100%;padding:.85rem 1rem;font-size:.92rem;font-family:'DM Sans',sans-serif;background:var(--ivory);border:1.5px solid var(--ivory-dark);border-radius:8px;color:var(--text);outline:none;transition:border-color .25s,box-shadow .25s,background .25s,transform .15s;}
    .field-input:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(45,80,22,.08);background:var(--white);transform:translateY(-1px);}
    .field-input:disabled{opacity:.5;cursor:not-allowed;background:var(--ivory-dark) !important;transform:none !important;}
    .field-input.invalid{border-color:var(--danger);box-shadow:0 0 0 4px rgba(220,38,38,.08);}
    .field-input::placeholder{color:rgba(90,107,82,.38);}
    textarea.field-input{resize:vertical;min-height:110px;line-height:1.7;}

    .input-line{position:absolute;bottom:0;left:50%;width:0;height:2px;background:var(--green);border-radius:2px;transition:width .35s cubic-bezier(.22,1,.36,1),left .35s cubic-bezier(.22,1,.36,1);pointer-events:none;}
    .field-input:focus ~ .input-line{width:100%;left:0;}

    .field-hint{margin-top:.35rem;font-size:.7rem;color:var(--text-light);font-family:'DM Mono',monospace;display:flex;align-items:center;gap:.3rem;}
    .field-error{margin-top:.35rem;font-size:.7rem;color:var(--danger);font-family:'DM Mono',monospace;display:none;}
    .field.has-error .field-error{display:block;}
    .field.has-error .field-hint{display:none;}

    /* ── Alerts ── */
    .alert{display:flex;align-items:center;gap:.7rem;padding:.9rem 1.1rem;border-radius:8px;font-size:.83rem;margin-bottom:1.5rem;border-left:3px solid;animation:alertIn .35s cubic-bezier(.22,1,.36,1);}
    @keyframes alertIn{from{opacity:0;transform:translateX(-10px);}to{opacity:1;transform:translateX(0);}}
    .alert-success{background:var(--success-bg);border-left-color:var(--success);color:#166534;}
    .alert-error{background:var(--danger-bg);border-left-color:var(--danger);color:#991B1B;}
    .alert-icon{font-size:1rem;flex-shrink:0;}

    /* ── Save button ── */
    .btn-row{display:flex;align-items:center;justify-content:space-between;margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(139,168,136,.18);}
    .btn-row-hint{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--text-light);letter-spacing:.05em;}
    .btn-save{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 2rem;background:var(--green);color:var(--ivory);border:none;border-radius:8px;font-size:.85rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;position:relative;overflow:hidden;font-family:'DM Sans',sans-serif;transition:background .3s,transform .2s,box-shadow .3s;}
    .btn-save .sheen{position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);transition:left .5s ease;}
    .btn-save:hover .sheen{left:100%;}
    .btn-save:hover{background:var(--green-light);transform:translateY(-2px);box-shadow:0 10px 28px rgba(45,80,22,.28);}
    .btn-save:active{transform:translateY(0);box-shadow:none;}
    .btn-save.loading{pointer-events:none;opacity:.75;}
    .btn-save.loading .btn-text{opacity:0;}
    .btn-save.loading::after{content:'';position:absolute;width:16px;height:16px;top:50%;left:50%;margin:-8px 0 0 -8px;border:2px solid rgba(255,255,240,.3);border-top-color:var(--ivory);border-radius:50%;animation:spin .65s linear infinite;}
    .btn-save svg{transition:transform .2s;}
    .btn-save:hover svg{transform:translateX(2px);}
    @keyframes spin{to{transform:rotate(360deg);}}

    /* ── Danger zone ── */
    .danger-zone{border-color:rgba(220,38,38,.2) !important;}
    .danger-zone .card-header{border-bottom-color:rgba(220,38,38,.15);}
    .danger-zone .card-icon{background:#FEF2F2;border-color:rgba(220,38,38,.2);}
    .danger-note{font-size:.83rem;color:var(--text-light);line-height:1.65;margin-bottom:1.25rem;font-weight:300;}
    .btn-danger{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.5rem;background:transparent;color:var(--danger);border:1.5px solid rgba(220,38,38,.35);border-radius:8px;font-size:.82rem;font-weight:500;letter-spacing:.05em;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .2s;position:relative;overflow:hidden;}
    .btn-danger:hover{background:var(--danger-bg);border-color:var(--danger);transform:translateY(-1px);}

    /* ── Member strip ── */
    .member-strip{display:flex;align-items:center;justify-content:center;gap:1rem;margin-top:2.5rem;animation:fadeUp .6s ease .5s both;}
    .member-dot{width:4px;height:4px;border-radius:50%;background:var(--sage);opacity:.5;}
    .member-text{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--text-light);letter-spacing:.08em;text-transform:uppercase;}

    /* ── Scroll reveal ── */
    .reveal{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s cubic-bezier(.22,1,.36,1);}
    .reveal.in{opacity:1;transform:translateY(0);}

    @media(max-width:640px){
      .stats{grid-template-columns:1fr 1fr;}
      .stat:nth-child(3){grid-column:1/-1;}
      .btn-row{flex-direction:column-reverse;gap:.75rem;align-items:stretch;}
      .btn-save{justify-content:center;}
      .btn-row-hint{text-align:center;}
    }
    @media(max-width:480px){
      .topbar{padding:0 1rem;}
      .ta .nb span:not(.keep){display:none;}
      .hero{padding:3rem 1.5rem 3.5rem;}
      .main{padding:2rem 1rem 3rem;}
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <nav class="topbar">
    <div class="tl">
      <div class="tlogo">👤</div>
      <span class="ttitle">Profile</span>
    </div>
    <div class="ta">
      <a href="/chat" class="nb np">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span class="keep">New Chat</span>
      </a>
      <a href="/history" class="nb ng">📚 <span>History</span></a>
      <form action="/logout" method="POST" style="display:inline">
        <button type="submit" class="nb ng">Logout</button>
      </form>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-mesh"></div>
    <div class="hero-ring hr1"></div>
    <div class="hero-ring hr2"></div>
    <div class="hero-ring hr3"></div>
    <div class="particles" id="particles"></div>

    <div class="hero-content">
      <!-- Completeness indicator -->
      <div class="complete-pill">
        <div class="complete-bar">
          <div class="complete-fill" id="completeFill"></div>
        </div>
        <span class="complete-text" id="completeText">Profile</span>
      </div>

      <!-- Avatar -->
      <div class="avatar-wrap">
        <div class="avatar-ring"></div>
        <div class="avatar-ring-2"></div>
        <div class="avatar" id="avatarEl">
          <%= name ? name.charAt(0).toUpperCase() : email.charAt(0).toUpperCase() %>
        </div>
      </div>

      <h1 class="hero-name" id="heroName"><%= name || 'Your Profile' %></h1>
      <p class="hero-email"><%= email %></p>
      <% if (bio) { %>
        <p class="hero-bio">"<%= bio %>"</p>
      <% } %>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">

    <!-- Stats -->
    <div class="stats">
      <div class="stat">
        <span class="stat-icon">💬</span>
        <div class="stat-val" id="statChats" data-target="<%= totalChats %>">0</div>
        <div class="stat-lbl">Total Chats</div>
      </div>
      <div class="stat">
        <span class="stat-icon">📨</span>
        <div class="stat-val" id="statMsgs" data-target="<%= totalMessages %>">0</div>
        <div class="stat-lbl">Messages Sent</div>
      </div>
      <div class="stat">
        <span class="stat-icon">📊</span>
        <div class="stat-val" id="statAvg" data-target="<%= totalChats > 0 ? Math.round(totalMessages / totalChats) : 0 %>">0</div>
        <div class="stat-lbl">Avg / Chat</div>
      </div>
    </div>

    <!-- Edit Profile Card -->
    <div class="section-label reveal">
      <div class="section-label-line"></div>
      <span class="section-label-text">Account Details</span>
      <div class="section-label-line"></div>
    </div>

    <div class="card reveal">
      <div class="card-header">
        <div class="card-icon">✏️</div>
        <h2 class="card-title">Edit Profile</h2>
      </div>
      <div class="card-body">

        <% if (successMessage) { %>
          <div class="alert alert-success">
            <span class="alert-icon">✓</span>
            <%= successMessage %>
          </div>
        <% } %>
        <% if (errorMessage) { %>
          <div class="alert alert-error">
            <span class="alert-icon">⚠</span>
            <%= errorMessage %>
          </div>
        <% } %>

        <form method="POST" action="/profile/update" id="profileForm" novalidate>

          <!-- Email -->
          <div class="field">
            <div class="field-label">
              <span class="field-label-text">Email Address</span>
            </div>
            <div class="input-wrap">
              <input class="field-input" id="emailField" type="email"
                     value="<%= email %>" disabled autocomplete="off">
            </div>
            <p class="field-hint">🔒 Email cannot be changed</p>
          </div>

          <!-- Name -->
          <div class="field" id="nameField">
            <div class="field-label">
              <span class="field-label-text">Display Name</span>
              <span class="field-required">required</span>
            </div>
            <div class="input-wrap">
              <input class="field-input" id="nameInput" name="name" type="text"
                     placeholder="Your name" required minlength="2" maxlength="60"
                     value="<%= name %>" autocomplete="name">
              <div class="input-line"></div>
            </div>
            <p class="field-hint">Minimum 2 characters</p>
            <p class="field-error" id="nameError">Name must be at least 2 characters</p>
          </div>

          <!-- Bio -->
          <div class="field">
            <div class="field-label">
              <span class="field-label-text">Bio</span>
              <span class="char-count" id="bioCount">
                <%= bio ? bio.length : 0 %> / 300
              </span>
            </div>
            <div class="input-wrap">
              <textarea class="field-input" id="bioInput" name="bio"
                        placeholder="A short line about yourself… (optional)"
                        maxlength="300"><%= bio %></textarea>
              <div class="input-line"></div>
            </div>
            <p class="field-hint">Optional · appears on your profile hero</p>
          </div>

          <div class="btn-row">
            <span class="btn-row-hint" id="formHint">
              <% if (typeof updatedAt !== 'undefined' && updatedAt) { %>
                Last saved · <%=
                  new Date(updatedAt.toDate ? updatedAt.toDate() : updatedAt)
                    .toLocaleDateString('en-IN',{month:'short',day:'numeric',timeZone:'Asia/Kolkata'})
                %>
              <% } else { %>
                Not saved yet
              <% } %>
            </span>
            <button type="submit" class="btn-save" id="saveBtn">
              <div class="sheen"></div>
              <span class="btn-text">Save Profile</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="btn-text"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="section-label reveal" style="animation-delay:.1s">
      <div class="section-label-line"></div>
      <span class="section-label-text">Danger Zone</span>
      <div class="section-label-line"></div>
    </div>

    <div class="card danger-zone reveal" style="animation-delay:.15s">
      <div class="card-header">
        <div class="card-icon">⚠️</div>
        <h2 class="card-title">Account Actions</h2>
      </div>
      <div class="card-body">
        <p class="danger-note">Logging out will end your current session. Your conversations and profile are safely stored and will be here when you return.</p>
        <form action="/logout" method="POST">
          <button type="submit" class="btn-danger">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign Out
          </button>
        </form>
      </div>
    </div>

    <!-- Member since -->
    <% if (createdAt) { %>
      <div class="member-strip">
        <div class="member-dot"></div>
        <span class="member-text">Member since
          <%= new Date(createdAt.toDate ? createdAt.toDate() : createdAt)
                .toLocaleDateString('en-IN',{month:'long',year:'numeric',timeZone:'Asia/Kolkata'}) %>
        </span>
        <div class="member-dot"></div>
      </div>
    <% } %>

  </div><!-- /main -->

  <script>
    /* ── Particles ── */
    const pc = document.getElementById('particles');
    for (let i = 0; i < 16; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      const s = Math.random() * 3.5 + 1.5;
      p.style.cssText = `width:${s}px;height:${s}px;left:${Math.random()*100}%;bottom:${Math.random()*20}%;animation-duration:${Math.random()*8+5}s;animation-delay:${Math.random()*8}s;`;
      pc.appendChild(p);
    }

    /* ── Count-up ── */
    function countUp(el, target, delay = 0) {
      setTimeout(() => {
        const dur = Math.min(1200, 400 + target * 8);
        const start = performance.now();
        const tick = now => {
          const p = Math.min((now - start) / dur, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(ease * target);
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = target;
        };
        requestAnimationFrame(tick);
      }, delay);
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const t = parseInt(el.dataset.target) || 0;
        countUp(el, t, 100);
        observer.unobserve(el);
      });
    }, { threshold: 0.4 });

    document.querySelectorAll('.stat-val[data-target]').forEach(el => observer.observe(el));

    /* ── Scroll reveal ── */
    const revealObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); revealObs.unobserve(e.target); }});
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

    /* ── Profile completeness ── */
    const name  = <%- JSON.stringify(name || '') %>;
    const bio   = <%- JSON.stringify(bio || '') %>;
    const email = <%- JSON.stringify(email || '') %>;

    function calcComplete() {
      let score = 0;
      if (email) score += 34;
      if (name && name.length >= 2) score += 33;
      if (bio  && bio.length  >= 10) score += 33;
      return score;
    }

    const pct = calcComplete();
    const fillEl = document.getElementById('completeFill');
    const textEl = document.getElementById('completeText');
    setTimeout(() => { fillEl.style.width = pct + '%'; }, 400);
    textEl.textContent = pct < 67 ? 'Incomplete' : pct < 100 ? 'Almost there' : 'Complete';

    /* ── Live bio char counter ── */
    const bioInput  = document.getElementById('bioInput');
    const bioCount  = document.getElementById('bioCount');
    const heroName  = document.getElementById('heroName');
    const avatarEl  = document.getElementById('avatarEl');
    const nameInput = document.getElementById('nameInput');

    bioInput.addEventListener('input', function() {
      const len = this.value.length;
      bioCount.textContent = `${len} / 300`;
      bioCount.className = 'char-count' + (len > 270 ? ' warn' : '') + (len >= 300 ? ' full' : '');
    });

    /* ── Live name → hero preview ── */
    nameInput.addEventListener('input', function() {
      const v = this.value.trim();
      heroName.textContent  = v || 'Your Profile';
      avatarEl.textContent  = v ? v.charAt(0).toUpperCase() : email.charAt(0).toUpperCase();
    });

    /* ── Client-side validation ── */
    const form      = document.getElementById('profileForm');
    const saveBtn   = document.getElementById('saveBtn');
    const nameField = document.getElementById('nameField');

    form.addEventListener('submit', function(e) {
      const val = nameInput.value.trim();
      if (!val || val.length < 2) {
        e.preventDefault();
        nameField.classList.add('has-error');
        nameInput.classList.add('invalid');
        nameInput.focus();
        return;
      }
      nameField.classList.remove('has-error');
      nameInput.classList.remove('invalid');
      saveBtn.classList.add('loading');
    });

    nameInput.addEventListener('input', function() {
      if (this.value.trim().length >= 2) {
        nameField.classList.remove('has-error');
        this.classList.remove('invalid');
      }
    });
  </script>

</body>
</html>
