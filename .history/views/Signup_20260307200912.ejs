<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account — Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --ivory: #FFFFF0;
      --ivory-dark: #F5F5DC;
      --green: #2D5016;
      --green-light: #3D6B23;
      --green-soft: #4A7C2F;
      --sage: #8BA888;
      --sage-light: rgba(139, 168, 136, 0.25);
      --white: #FFFFFF;
      --text: #1A2E0F;
      --text-light: #5A6B52;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--ivory);
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* ── LEFT PANEL ── */
    .panel-left {
      width: 52%;
      background: var(--green);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3.5rem 4rem;
      overflow: hidden;
    }

    .panel-left::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 70% 30%, rgba(139,168,136,0.15) 0%, transparent 55%),
        radial-gradient(ellipse at 20% 80%, rgba(255,255,240,0.06) 0%, transparent 50%);
      pointer-events: none;
    }

    .ring {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(139,168,136,0.2);
    }
    .ring-1 { width: 500px; height: 500px; bottom: -150px; right: -150px; }
    .ring-2 { width: 320px; height: 320px; bottom: -80px; right: -60px; border-color: rgba(139,168,136,0.12); }
    .ring-3 { width: 600px; height: 600px; top: -250px; left: -200px; border-color: rgba(255,255,240,0.05); }

    /* Diagonal decorative line */
    .deco-line {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      pointer-events: none;
      z-index: 1;
    }

    .steps-visual {
      position: relative;
      z-index: 2;
    }

    .step-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.45rem 1rem;
      background: rgba(255,255,240,0.08);
      border: 1px solid rgba(139,168,136,0.3);
      border-radius: 100px;
      margin-bottom: 2.5rem;
    }
    .step-label span {
      font-size: 0.72rem;
      color: var(--sage);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: 'DM Mono', monospace;
    }

    .left-headline {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.5rem, 3.5vw, 3.8rem);
      font-weight: 300;
      color: var(--ivory);
      line-height: 1.12;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
    }
    .left-headline em {
      font-style: italic;
      color: var(--sage);
    }

    .left-tagline {
      font-size: 0.92rem;
      color: rgba(255,255,240,0.45);
      font-weight: 300;
      line-height: 1.75;
      max-width: 320px;
    }

    /* Step indicators */
    .onboarding-steps {
      margin-top: 3.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .onboarding-step {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }
    .step-num {
      width: 28px; height: 28px;
      border-radius: 50%;
      border: 1px solid rgba(139,168,136,0.4);
      display: flex; align-items: center; justify-content: center;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      color: var(--sage);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .step-text h4 {
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255,255,240,0.8);
      margin-bottom: 0.2rem;
    }
    .step-text p {
      font-size: 0.78rem;
      color: rgba(255,255,240,0.38);
      font-weight: 300;
    }

    /* ── RIGHT PANEL ── */
    .panel-right {
      width: 48%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 4rem;
      overflow-y: auto;
    }

    .auth-card {
      width: 100%;
      max-width: 400px;
      animation: slideUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(28px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-greeting {
      margin-bottom: 2.5rem;
    }
    .auth-greeting-sub {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      color: var(--sage);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }
    .auth-greeting h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem;
      font-weight: 400;
      color: var(--green);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    #authMessage {
      display: none;
      padding: 0.9rem 1.1rem;
      border-radius: 6px;
      font-size: 0.83rem;
      margin-bottom: 1.5rem;
      border-left: 3px solid;
      animation: slideDown 0.3s ease;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    #authMessage.show { display: block; }
    #authMessage.error { background: #FEF2F2; border-left-color: #DC2626; color: #991B1B; }
    #authMessage.success { background: #F0FDF4; border-left-color: #16A34A; color: #166534; }

    .field { margin-bottom: 1.3rem; }
    .field-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-light);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }
    .field-input {
      width: 100%;
      padding: 0.9rem 1.1rem;
      font-size: 0.95rem;
      font-family: 'DM Sans', sans-serif;
      background: var(--white);
      border: 1.5px solid var(--ivory-dark);
      border-radius: 8px;
      color: var(--text);
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    .field-input:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3.5px rgba(45,80,22,0.1);
    }
    .field-input::placeholder { color: rgba(90,107,82,0.4); }

    .field-hint {
      margin-top: 0.4rem;
      font-size: 0.72rem;
      color: var(--text-light);
      font-family: 'DM Mono', monospace;
    }

    /* Password strength */
    .strength-bar {
      margin-top: 0.5rem;
      height: 3px;
      border-radius: 3px;
      background: var(--ivory-dark);
      overflow: hidden;
    }
    .strength-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.3s, background 0.3s;
      width: 0%;
      background: var(--sage);
    }

    .btn-primary {
      width: 100%;
      padding: 0.95rem;
      background: var(--green);
      color: var(--ivory);
      border: none;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.25s, transform 0.15s, box-shadow 0.25s;
      font-family: 'DM Sans', sans-serif;
      margin-top: 0.5rem;
    }
    .btn-primary:hover {
      background: var(--green-light);
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(45,80,22,0.28);
    }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary.loading { pointer-events: none; opacity: 0.65; }

    .signin-prompt {
      margin-top: 1.8rem;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-light);
    }
    .signin-prompt a {
      color: var(--green);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid var(--sage);
      padding-bottom: 1px;
      transition: border-color 0.2s;
    }
    .signin-prompt a:hover { border-color: var(--green); }

    @media (max-width: 840px) {
      body { flex-direction: column; overflow: auto; }
      .panel-left { width: 100%; padding: 2.5rem 2rem; min-height: 240px; }
      .panel-right { width: 100%; padding: 2.5rem 2rem; }
      .onboarding-steps { display: none; }
    }
  </style>
</head>
<body>

  <!-- LEFT PANEL -->
  <div class="panel-left">
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
    <div class="ring ring-3"></div>

    <div class="steps-visual">
      <div class="step-label">
        <span>New Account</span>
      </div>
      <h1 class="left-headline">
        Begin your<br><em>journey</em><br>today
      </h1>
      <p class="left-tagline">
        Join thousands who use this space to find clarity and direction in life's hardest moments.
      </p>

      <div class="onboarding-steps">
        <div class="onboarding-step">
          <div class="step-num">01</div>
          <div class="step-text">
            <h4>Create your account</h4>
            <p>Secure and private, always yours</p>
          </div>
        </div>
        <div class="onboarding-step">
          <div class="step-num">02</div>
          <div class="step-text">
            <h4>Share what's on your mind</h4>
            <p>Your AI companion listens without judgment</p>
          </div>
        </div>
        <div class="onboarding-step">
          <div class="step-num">03</div>
          <div class="step-text">
            <h4>Gain clarity and act</h4>
            <p>Walk away with confidence in your choice</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="panel-right">
    <div class="auth-card">
      <div class="auth-greeting">
        <p class="auth-greeting-sub">Get started</p>
        <h2>Create your<br>account</h2>
      </div>

      <div id="authMessage"></div>

      <form id="signupForm" onsubmit="return false;">
        <div class="field">
          <label class="field-label" for="email">Email Address</label>
          <input class="field-input" id="email" type="email" placeholder="you@example.com" required autocomplete="email">
        </div>

        <div class="field">
          <label class="field-label" for="password">Password</label>
          <input class="field-input" id="password" type="password" placeholder="••••••••" required autocomplete="new-password" minlength="6" oninput="updateStrength(this.value)">
          <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
          <p class="field-hint">minimum 6 characters</p>
        </div>

        <div class="field">
          <label class="field-label" for="confirmPassword">Confirm Password</label>
          <input class="field-input" id="confirmPassword" type="password" placeholder="••••••••" required autocomplete="new-password" minlength="6">
        </div>

        <button type="submit" class="btn-primary" id="signupBtn" onclick="createAccount()">
          Create Account
        </button>
      </form>

      <p class="signin-prompt">Already have an account? <a href="/">Sign in</a></p>
    </div>
  </div>

  <script>
    function updateStrength(val) {
      const fill = document.getElementById('strengthFill');
      const len = val.length;
      let pct = 0, color = '#8BA888';
      if (len >= 6) { pct = 40; color = '#f59e0b'; }
      if (len >= 10) { pct = 75; color = '#3D6B23'; }
      if (len >= 14 && /[^a-zA-Z0-9]/.test(val)) { pct = 100; color = '#2D5016'; }
      fill.style.width = pct + '%';
      fill.style.background = color;
    }
  </script>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getAuth, createUserWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",
      authDomain: "life-decision-helper.firebaseapp.com",
      projectId: "life-decision-helper"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    function showMessage(msg, isError = true) {
      const el = document.getElementById("authMessage");
      el.className = `${isError ? 'error' : 'success'} show`;
      el.innerText = msg;
      setTimeout(() => el.classList.remove('show'), 5000);
    }

    window.createAccount = async () => {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const confirmPassword = document.getElementById("confirmPassword").value.trim();
      const btn = document.getElementById("signupBtn");

      if (!email || !password || !confirmPassword) { showMessage("Please fill in all fields"); return; }
      if (password !== confirmPassword) { showMessage("Passwords do not match"); return; }
      if (password.length < 6) { showMessage("Password must be at least 6 characters"); return; }

      btn.classList.add('loading');
      btn.textContent = 'Creating account…';

      try {
        const userCred = await createUserWithEmailAndPassword(auth, email, password);
        const token = await userCred.user.getIdToken();
        document.cookie = `token=${token}; path=/`;
        showMessage("✓ Account created! Redirecting…", false);
        setTimeout(() => window.location.href = "/chat", 1500);
      } catch (err) {
        btn.classList.remove('loading');
        btn.textContent = 'Create Account';
        let msg = err.message;
        if (err.code === 'auth/email-already-in-use') msg = "This email is already registered";
        else if (err.code === 'auth/invalid-email') msg = "Please enter a valid email address";
        else if (err.code === 'auth/weak-password') msg = "Password is too weak";
        showMessage(msg);
      }
    };

    document.getElementById('signupForm').addEventListener('keypress', e => { if (e.key === 'Enter') createAccount(); });
  </script>
</body>
</html>
