<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account - Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #2D5F5D;
      --primary-light: #3D7F7D;
      --accent: #F4A261;
      --text: #1A3130;
      --text-light: #5A7877;
      --bg: #FDFCF8;
      --card-bg: #FFFFFF;
      --error: #E76F51;
      --success: #52B788;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background-image: 
        radial-gradient(circle at 20% 80%, rgba(45, 95, 93, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(244, 162, 97, 0.03) 0%, transparent 50%);
    }

    .container {
      max-width: 440px;
      width: 100%;
      animation: fadeIn 0.6s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .logo {
      font-size: 3.5rem;
      margin-bottom: 0.5rem;
      display: inline-block;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    h1 {
      font-family: 'Fraunces', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1rem;
      color: var(--text-light);
      font-weight: 400;
    }

    .card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 2.5rem;
      box-shadow: 
        0 4px 6px rgba(45, 95, 93, 0.03),
        0 10px 20px rgba(45, 95, 93, 0.05);
      border: 1px solid rgba(45, 95, 93, 0.08);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text);
      margin-bottom: 0.5rem;
      letter-spacing: 0.01em;
    }

    input {
      width: 100%;
      padding: 0.875rem 1rem;
      font-size: 1rem;
      font-family: 'DM Sans', sans-serif;
      border: 2px solid rgba(45, 95, 93, 0.15);
      border-radius: 12px;
      background: var(--bg);
      color: var(--text);
      transition: all 0.3s ease;
      outline: none;
    }

    input:focus {
      border-color: var(--primary);
      background: var(--card-bg);
      box-shadow: 0 0 0 4px rgba(45, 95, 93, 0.08);
    }

    input::placeholder {
      color: var(--text-light);
      opacity: 0.6;
    }

    .password-hint {
      font-size: 0.75rem;
      color: var(--text-light);
      margin-top: 0.375rem;
    }

    button {
      width: 100%;
      padding: 1rem;
      font-size: 1rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
      margin-bottom: 1rem;
    }

    .btn-primary:hover {
      background: var(--primary-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(45, 95, 93, 0.25);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 1.5rem 0;
      color: var(--text-light);
      font-size: 0.875rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid rgba(45, 95, 93, 0.15);
    }

    .divider span {
      padding: 0 1rem;
    }

    .signin-link {
      text-align: center;
      font-size: 0.9375rem;
      color: var(--text-light);
    }

    .signin-link a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    .signin-link a:hover {
      color: var(--primary-light);
      text-decoration: underline;
    }

    .message {
      padding: 0.875rem 1rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9375rem;
      display: none;
      animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.show {
      display: block;
    }

    .message.error {
      background: rgba(231, 111, 81, 0.1);
      color: var(--error);
      border: 1px solid rgba(231, 111, 81, 0.3);
    }

    .message.success {
      background: rgba(82, 183, 136, 0.1);
      color: var(--success);
      border: 1px solid rgba(82, 183, 136, 0.3);
    }

    .features {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(45, 95, 93, 0.1);
    }

    .feature {
      display: flex;
      align-items: center;
      margin-bottom: 0.875rem;
      font-size: 0.875rem;
      color: var(--text-light);
    }

    .feature-icon {
      width: 24px;
      height: 24px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 0.75rem;
      font-size: 0.75rem;
      flex-shrink: 0;
    }

    @media (max-width: 480px) {
      body {
        padding: 1rem;
      }

      h1 {
        font-size: 1.75rem;
      }

      .card {
        padding: 2rem 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">🧭</div>
      <h1>Create Your Account</h1>
      <p class="subtitle">Start making better decisions today</p>
    </div>

    <div class="card">
      <div id="authMessage" class="message"></div>

      <form id="signupForm" onsubmit="return false;">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input 
            id="email" 
            type="email" 
            placeholder="you@example.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input 
            id="password" 
            type="password" 
            placeholder="Create a secure password"
            required
            autocomplete="new-password"
            minlength="6"
          />
          <div class="password-hint">Minimum 6 characters</div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input 
            id="confirmPassword" 
            type="password" 
            placeholder="Re-enter your password"
            required
            autocomplete="new-password"
            minlength="6"
          />
        </div>

        <button type="submit" class="btn-primary" onclick="createAccount()">
          ✨ Create Account
        </button>
      </form>

      <div class="divider">
        <span>Already have an account?</span>
      </div>

      <div class="signin-link">
        <a href="/">Sign in instead</a>
      </div>

      <div class="features">
        <div class="feature">
          <div class="feature-icon">🔒</div>
          <span>Secure and private decision tracking</span>
        </div>
        <div class="feature">
          <div class="feature-icon">💡</div>
          <span>AI-powered decision assistance</span>
        </div>
        <div class="feature">
          <div class="feature-icon">📊</div>
          <span>Track your decision history</span>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import {
      getAuth,
      createUserWithEmailAndPassword
    } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",
      authDomain: "life-decision-helper.firebaseapp.com",
      projectId: "life-decision-helper"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    function showMessage(msg, isError = true) {
      const el = document.getElementById("authMessage");
      el.className = `message ${isError ? 'error' : 'success'} show`;
      el.innerText = msg;
      
      setTimeout(() => {
        el.classList.remove('show');
      }, 5000);
    }

    window.createAccount = async () => {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const confirmPassword = document.getElementById("confirmPassword").value.trim();

      if (!email || !password || !confirmPassword) {
        showMessage("Please fill in all fields");
        return;
      }

      if (password !== confirmPassword) {
        showMessage("Passwords do not match");
        return;
      }

      if (password.length < 6) {
        showMessage("Password must be at least 6 characters");
        return;
      }

      try {
        const userCred = await createUserWithEmailAndPassword(auth, email, password);
        const token = await userCred.user.getIdToken();

        document.cookie = `token=${token}; path=/`;
        
        showMessage("✅ Account created successfully! Redirecting...", false);
        
        setTimeout(() => {
          window.location.href = "/chat";
        }, 1500);
      } catch (err) {
        let errorMessage = err.message;
        
        if (err.code === 'auth/email-already-in-use') {
          errorMessage = "This email is already registered. Try signing in instead.";
        } else if (err.code === 'auth/invalid-email') {
          errorMessage = "Please enter a valid email address.";
        } else if (err.code === 'auth/weak-password') {
          errorMessage = "Password is too weak. Please use a stronger password.";
        }
        
        showMessage(errorMessage);
      }
    };

    document.getElementById('signupForm').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        createAccount();
      }
    });
  </script>
</body>
</html>