<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Life Decision Helper — Sign In</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --ivory: #FFFFF0;
      --ivory-dark: #F5F5DC;
      --green: #2D5016;
      --green-light: #3D6B23;
      --green-soft: #4A7C2F;
      --sage: #8BA888;
      --white: #FFFFFF;
      --text: #1A2E0F;
      --text-light: #5A6B52;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'DM Sans',sans-serif;background:var(--ivory);min-height:100vh;display:flex;overflow:hidden;}

    /* ══ LEFT ══ */
    .panel-left{width:52%;background:var(--green);position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:3.5rem 4rem;overflow:hidden;}

    .mesh{position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(ellipse 60% 50% at 30% 20%,rgba(139,168,136,.22) 0%,transparent 70%),
                 radial-gradient(ellipse 50% 60% at 75% 75%,rgba(255,255,240,.06) 0%,transparent 70%);
      animation:meshShift 9s ease-in-out infinite alternate;}
    @keyframes meshShift{from{opacity:.8;transform:scale(1);}to{opacity:1;transform:scale(1.06);}}

    .ring{position:absolute;border-radius:50%;border:1px solid rgba(139,168,136,.2);animation:ringRotate linear infinite;}
    .r1{width:560px;height:560px;top:-120px;right:-200px;animation-duration:40s;}
    .r2{width:380px;height:380px;top:-40px;right:-100px;border-color:rgba(139,168,136,.12);animation-duration:28s;animation-direction:reverse;}
    .r3{width:700px;height:700px;bottom:-280px;left:-200px;border-color:rgba(255,255,240,.05);animation-duration:55s;}
    .r4{width:200px;height:200px;bottom:80px;right:60px;border-color:rgba(139,168,136,.15);animation-duration:20s;animation-direction:reverse;}
    @keyframes ringRotate{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}

    .particles{position:absolute;inset:0;pointer-events:none;z-index:1;}
    .particle{position:absolute;border-radius:50%;background:rgba(139,168,136,.4);animation:floatP linear infinite;}
    @keyframes floatP{0%{opacity:0;transform:translateY(0) scale(1);}15%{opacity:1;}85%{opacity:.5;}100%{opacity:0;transform:translateY(-140px) translateX(20px) scale(.3);}}

    .dots-grid{position:absolute;bottom:3.5rem;right:3.5rem;display:grid;grid-template-columns:repeat(5,1fr);gap:10px;z-index:2;}
    .dt{width:3px;height:3px;border-radius:50%;background:rgba(139,168,136,.35);transition:transform .25s,opacity .25s,background .25s;}

    .left-brand{position:relative;z-index:3;}
    .brand-badge{display:inline-flex;align-items:center;gap:.6rem;padding:.45rem 1rem;background:rgba(255,255,240,.08);border:1px solid rgba(139,168,136,.3);border-radius:100px;margin-bottom:3rem;animation:fadeDown .8s cubic-bezier(.22,1,.36,1) .2s both;}
    .brand-badge span{font-size:.72rem;color:var(--sage);letter-spacing:.12em;text-transform:uppercase;font-family:'DM Mono',monospace;}
    .badge-dot{width:6px;height:6px;border-radius:50%;background:var(--sage);animation:pulse 2.5s ease-in-out infinite;}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.35;transform:scale(.6);}}
    @keyframes fadeDown{from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);}}

    /* Headline reveal */
    .hl{font-family:'Cormorant Garamond',serif;font-size:clamp(2.8rem,4vw,4.4rem);font-weight:300;color:var(--ivory);line-height:1.1;letter-spacing:-.02em;}
    .hl em{font-style:italic;color:var(--sage);}
    .hl-line{display:block;overflow:hidden;}
    .hl-line span{display:block;animation:lineUp .9s cubic-bezier(.22,1,.36,1) both;}
    .hl-line:nth-child(1) span{animation-delay:.35s;}
    .hl-line:nth-child(2) span{animation-delay:.5s;}
    .hl-line:nth-child(3) span{animation-delay:.65s;}
    @keyframes lineUp{from{transform:translateY(110%);}to{transform:translateY(0);}}

    .tagline{margin-top:1.5rem;font-size:.93rem;color:rgba(255,255,240,.5);font-weight:300;line-height:1.75;max-width:300px;animation:fadeUp .8s ease .85s both;}

    .feat-list{list-style:none;display:flex;flex-direction:column;gap:1.1rem;position:relative;z-index:3;}
    .feat-item{display:flex;align-items:center;gap:1rem;color:rgba(255,255,240,.62);font-size:.875rem;font-weight:300;animation:fadeUp .7s ease both;transition:color .25s;}
    .feat-item:nth-child(1){animation-delay:1s;}
    .feat-item:nth-child(2){animation-delay:1.1s;}
    .feat-item:nth-child(3){animation-delay:1.2s;}
    .feat-item:hover{color:rgba(255,255,240,.9);}
    .feat-icon{width:34px;height:34px;background:rgba(139,168,136,.12);border:1px solid rgba(139,168,136,.2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;transition:all .3s;}
    .feat-item:hover .feat-icon{background:rgba(139,168,136,.28);transform:scale(1.12) rotate(6deg);}

    @keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

    /* ══ RIGHT ══ */
    .panel-right{width:48%;display:flex;align-items:center;justify-content:center;padding:3rem 4rem;overflow-y:auto;position:relative;}
    .panel-right::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(139,168,136,.08) 1px,transparent 1px);background-size:28px 28px;animation:patternDrift 18s linear infinite;pointer-events:none;}
    @keyframes patternDrift{from{background-position:0 0;}to{background-position:28px 28px;}}

    .auth-card{width:100%;max-width:400px;position:relative;z-index:2;animation:cardIn .85s cubic-bezier(.22,1,.36,1) .1s both;}
    @keyframes cardIn{from{opacity:0;transform:translateY(32px) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}

    .greeting{margin-bottom:2.8rem;}
    .greeting-sub{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--sage);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.6rem;animation:fadeUp .6s ease .4s both;}
    .greeting h2{font-family:'Cormorant Garamond',serif;font-size:2.5rem;font-weight:400;color:var(--green);letter-spacing:-.02em;line-height:1.15;animation:fadeUp .7s ease .5s both;}

    #authMessage{display:none;padding:.9rem 1.1rem;border-radius:8px;font-size:.83rem;margin-bottom:1.5rem;border-left:3px solid;}
    #authMessage.show{display:block;animation:shakeIn .4s ease;}
    @keyframes shakeIn{0%,100%{transform:translateX(0);}20%{transform:translateX(-7px);}40%{transform:translateX(5px);}60%{transform:translateX(-3px);}80%{transform:translateX(2px);}}
    #authMessage.error{background:#FEF2F2;border-left-color:#DC2626;color:#991B1B;}
    #authMessage.success{background:#F0FDF4;border-left-color:#16A34A;color:#166534;}

    .field{margin-bottom:1.4rem;animation:fadeUp .6s ease both;}
    .field:nth-of-type(1){animation-delay:.6s;}
    .field:nth-of-type(2){animation-delay:.7s;}
    .field-label{display:block;font-size:.75rem;font-weight:500;color:var(--text-light);letter-spacing:.06em;text-transform:uppercase;margin-bottom:.55rem;transition:color .2s;}
    .field:focus-within .field-label{color:var(--green);}
    .input-wrap{position:relative;}
    .field-input{width:100%;padding:.9rem 1.1rem;font-size:.95rem;font-family:'DM Sans',sans-serif;background:var(--white);border:1.5px solid var(--ivory-dark);border-radius:8px;color:var(--text);outline:none;transition:border-color .25s,box-shadow .25s,transform .2s;}
    .field-input:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(45,80,22,.1);transform:translateY(-1px);}
    .field-input::placeholder{color:rgba(90,107,82,.38);}
    /* Animated underline */
    .input-line{position:absolute;bottom:0;left:50%;width:0;height:2px;background:var(--green);border-radius:2px;transition:width .35s ease,left .35s ease;}
    .field-input:focus ~ .input-line{width:100%;left:0;}

    /* Primary btn */
    .btn-primary{width:100%;padding:.95rem;background:var(--green);color:var(--ivory);border:none;border-radius:8px;font-size:.88rem;font-weight:500;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;position:relative;overflow:hidden;font-family:'DM Sans',sans-serif;margin-top:.5rem;transition:background .3s,transform .2s,box-shadow .3s;animation:fadeUp .6s ease .8s both;}
    .btn-primary .sheen{position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);transition:left .55s ease;}
    .btn-primary:hover .sheen{left:100%;}
    .btn-primary:hover{background:var(--green-light);transform:translateY(-2px);box-shadow:0 10px 30px rgba(45,80,22,.3);}
    .btn-primary:active{transform:translateY(0);box-shadow:none;}
    .btn-primary.loading{pointer-events:none;opacity:.7;}
    .btn-primary.loading .btn-text{opacity:0;}
    .btn-primary.loading::before{content:'';position:absolute;width:18px;height:18px;top:50%;left:50%;margin:-9px 0 0 -9px;border:2px solid rgba(255,255,240,.35);border-top-color:var(--ivory);border-radius:50%;animation:spin .65s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}

    .divider{display:flex;align-items:center;gap:1rem;margin:1.8rem 0;animation:fadeUp .6s ease .9s both;}
    .divider-line{flex:1;height:1px;background:var(--ivory-dark);}
    .divider-text{font-size:.75rem;color:var(--text-light);white-space:nowrap;font-weight:300;}

    .btn-secondary{width:100%;padding:.9rem;background:transparent;color:var(--green);border:1.5px solid var(--ivory-dark);border-radius:8px;font-size:.88rem;font-weight:500;letter-spacing:.05em;cursor:pointer;transition:border-color .25s,background .25s,transform .2s;font-family:'DM Sans',sans-serif;animation:fadeUp .6s ease 1s both;position:relative;overflow:hidden;}
    .btn-secondary .ripple-bg{position:absolute;top:50%;left:50%;width:0;height:0;background:rgba(45,80,22,.07);border-radius:50%;transform:translate(-50%,-50%);transition:width .55s,height .55s;}
    .btn-secondary:hover .ripple-bg{width:320px;height:320px;}
    .btn-secondary:hover{border-color:var(--sage);transform:translateY(-1px);}

    .auth-footer{margin-top:1.5rem;text-align:center;font-size:.78rem;color:var(--text-light);animation:fadeUp .6s ease 1.1s both;}

    @media(max-width:840px){body{flex-direction:column;overflow:auto;}.panel-left{width:100%;padding:2.5rem 2rem;min-height:280px;}.panel-right{width:100%;padding:2.5rem 2rem;}.feat-list{display:none;}}
  </style>
</head>
<body>
  <!-- LEFT -->
  <div class="panel-left">
    <div class="mesh"></div>
    <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div><div class="ring r4"></div>
    <div class="particles" id="particles"></div>
    <div class="dots-grid" id="dotsGrid"></div>

    <div class="left-brand">
      <div class="brand-badge"><div class="badge-dot"></div><span>Life Decision Helper</span></div>
      <h1 class="hl">
        <span class="hl-line"><span>Clarity</span></span>
        <span class="hl-line"><span>in every</span></span>
        <span class="hl-line"><span><em>choice</em></span></span>
      </h1>
      <p class="tagline">A thoughtful space to navigate life's decisions with confidence and calm.</p>
    </div>

    <ul class="feat-list">
      <li class="feat-item"><div class="feat-icon">🧭</div>Guided decision frameworks</li>
      <li class="feat-item"><div class="feat-icon">💬</div>Empathetic AI conversation</li>
      <li class="feat-item"><div class="feat-icon">📚</div>Full conversation history</li>
    </ul>
  </div>

  <!-- RIGHT -->
  <div class="panel-right">
    <div class="auth-card">
      <div class="greeting">
        <p class="greeting-sub">Welcome back</p>
        <h2>Sign in to<br>your account</h2>
      </div>
      <div id="authMessage"></div>
      <form id="loginForm" onsubmit="return false;">
        <div class="field">
          <label class="field-label" for="email">Email Address</label>
          <div class="input-wrap">
            <input class="field-input" id="email" type="email" placeholder="you@example.com" required autocomplete="email">
            <div class="input-line"></div>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="password">Password</label>
          <div class="input-wrap">
            <input class="field-input" id="password" type="password" placeholder="••••••••" required autocomplete="current-password">
            <div class="input-line"></div>
          </div>
        </div>
        <button type="submit" class="btn-primary" id="loginBtn" onclick="login()">
          <div class="sheen"></div>
          <span class="btn-text">Sign In</span>
        </button>
      </form>
      <div class="divider"><div class="divider-line"></div><span class="divider-text">don't have an account?</span><div class="divider-line"></div></div>
      <button class="btn-secondary" onclick="window.location.href='/Signup'"><div class="ripple-bg"></div>Create Account</button>
      <p class="auth-footer">Your journey to clarity starts here.</p>
    </div>
  </div>

  <script>
    // Particles
    const pc=document.getElementById('particles');
    for(let i=0;i<20;i++){const p=document.createElement('div');p.className='particle';const s=Math.random()*4+2;p.style.cssText=`width:${s}px;height:${s}px;left:${Math.random()*100}%;bottom:${Math.random()*25}%;animation-duration:${Math.random()*9+5}s;animation-delay:${Math.random()*9}s;`;pc.appendChild(p);}
    // Dots
    const dg=document.getElementById('dotsGrid');
    for(let i=0;i<25;i++){const d=document.createElement('div');d.className='dt';dg.appendChild(d);}
    const allDots=dg.querySelectorAll('.dt');
    dg.addEventListener('mousemove',e=>{const r=dg.getBoundingClientRect();allDots.forEach(d=>{const dr=d.getBoundingClientRect();const dist=Math.sqrt(Math.pow(dr.left+1.5-r.left-e.clientX+r.left,2)+Math.pow(dr.top+1.5-r.top-e.clientY+r.top,2));const sc=Math.max(1,3.5-dist/18);d.style.transform=`scale(${sc})`;d.style.background=`rgba(139,168,136,${Math.min(.9,.35+sc*.2)})`;});});
    dg.addEventListener('mouseleave',()=>{allDots.forEach(d=>{d.style.transform='scale(1)';d.style.background='';});});
  </script>

  <script type="module">
    import{initializeApp}from"https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import{getAuth,signInWithEmailAndPassword}from"https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
    const auth=getAuth(initializeApp({apiKey:"AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",authDomain:"life-decision-helper.firebaseapp.com",projectId:"life-decision-helper"}));
    function showMsg(msg,isErr=true){const el=document.getElementById("authMessage");el.className=`${isErr?'error':'success'} show`;el.innerText=msg;setTimeout(()=>el.classList.remove('show'),5000);}
    window.login=async()=>{
      const e=document.getElementById("email").value.trim(),p=document.getElementById("password").value.trim(),btn=document.getElementById("loginBtn");
      if(!e||!p){showMsg("Please fill in all fields");return;}
      btn.classList.add('loading');
      try{const uc=await signInWithEmailAndPassword(auth,e,p);document.cookie=`token=${await uc.user.getIdToken()}; path=/`;showMsg("✓ Welcome back!",false);setTimeout(()=>window.location.href="/chat",800);}
      catch(err){btn.classList.remove('loading');let m="Something went wrong";if(err.code==='auth/user-not-found'||err.code==='auth/wrong-password')m="Invalid email or password";else if(err.code==='auth/invalid-email')m="Please enter a valid email";else if(err.code==='auth/too-many-requests')m="Too many attempts. Try later";showMsg(m);}
    };
    document.getElementById('loginForm').addEventListener('keypress',e=>{if(e.key==='Enter')window.login();});
  </script>
</body>
</html>
