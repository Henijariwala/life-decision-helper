<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat History - Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #2D5F5D;
      --primary-light: #3D7F7D;
      --accent: #F4A261;
      --text: #1A3130;
      --text-light: #5A7877;
      --bg: #FDFCF8;
      --card-bg: #FFFFFF;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      background-image: 
        radial-gradient(circle at 20% 80%, rgba(45, 95, 93, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(244, 162, 97, 0.03) 0%, transparent 50%);
      min-height: 100vh;
      padding: 40px 20px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
    }

    .header {
      margin-bottom: 40px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    h1 {
      font-family: 'Fraunces', serif;
      font-size: 2.5rem;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .subtitle {
      color: var(--text-light);
      font-size: 1.125rem;
    }

    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      display: inline-block;
      font-size: 15px;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(45, 95, 93, 0.25);
    }

    .chat-list {
      display: grid;
      gap: 20px;
    }

    .chat-card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 24px;
      border: 1px solid rgba(45, 95, 93, 0.1);
      box-shadow: 0 2px 8px rgba(45, 95, 93, 0.05);
      transition: all 0.3s;
      cursor: pointer;
      position: relative;
    }

    .chat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(45, 95, 93, 0.15);
      border-color: var(--primary);
    }

    .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 12px;
    }

    .chat-meta {
      flex: 1;
    }

    .chat-title {
      font-weight: 600;
      font-size: 1.125rem;
      color: var(--primary);
      margin-bottom: 4px;
    }

    .chat-date {
      font-size: 0.875rem;
      color: var(--text-light);
    }

    .chat-stats {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .stat {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.875rem;
      color: var(--text-light);
    }

    .chat-preview {
      color: var(--text);
      line-height: 1.6;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid rgba(45, 95, 93, 0.1);
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(45, 95, 93, 0.1);
      color: var(--primary);
    }

    .chat-actions {
      display: flex;
      gap: 8px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid rgba(45, 95, 93, 0.1);
    }

    .btn-small {
      padding: 8px 16px;
      font-size: 0.875rem;
      border-radius: 8px;
    }

    .btn-secondary {
      background: transparent;
      color: var(--primary);
      border: 2px solid var(--primary);
    }

    .btn-secondary:hover {
      background: var(--primary);
      color: white;
    }

    .btn-danger {
      background: #E76F51;
      color: white;
    }

    .btn-danger:hover {
      background: #d85e43;
    }

    .empty-state {
      text-align: center;
      padding: 80px 20px;
      background: var(--card-bg);
      border-radius: 16px;
      border: 1px solid rgba(45, 95, 93, 0.1);
    }

    .empty-state-icon {
      font-size: 64px;
      margin-bottom: 16px;
      opacity: 0.6;
    }

    .empty-state h3 {
      font-family: 'Fraunces', serif;
      font-size: 1.75rem;
      margin-bottom: 8px;
      color: var(--text);
    }

    .empty-state p {
      color: var(--text-light);
      margin-bottom: 24px;
    }

    @media (max-width: 768px) {
      h1 {
        font-size: 2rem;
      }

      .header-top {
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
      }

      .chat-header {
        flex-direction: column;
        gap: 12px;
      }

      .chat-stats {
        flex-wrap: wrap;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="header-top">
        <div>
          <h1>📚 Chat History</h1>
          <p class="subtitle">All your conversations are saved here</p>
        </div>
        <a href="/chat" class="btn btn-primary">✨ New Chat</a>
      </div>
    </div>

    <div class="chat-list">
      <% if (decisions.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon">💬</div>
          <h3>No chats yet</h3>
          <p>Start a conversation to see your chat history here</p>
          <a href="/chat" class="btn btn-primary">Start Your First Chat</a>
        </div>
      <% } else { %>
        <% decisions.forEach(decision => { %>
          <div class="chat-card" onclick="openChat('<%= decision.id %>')">
            <div class="chat-header">
              <div class="chat-meta">
                <div class="chat-title">
                  <%= decision.preview ? decision.preview.substring(0, 60) + (decision.preview.length > 60 ? '...' : '') : 'New Conversation' %>
                </div>
                <div class="chat-date">
                  <%
                    // FIXED: Better date handling with proper error checking
                    let dateString = 'Unknown date';
                    try {
                      if (decision.createdAt) {
                        if (decision.createdAt._seconds) {
                          // Firestore Timestamp format
                          dateString = new Date(decision.createdAt._seconds * 1000).toLocaleString();
                        } else if (typeof decision.createdAt === 'string' || typeof decision.createdAt === 'number') {
                          // ISO string or timestamp
                          dateString = new Date(decision.createdAt).toLocaleString();
                        } else if (decision.createdAt.toDate) {
                          // Firestore Timestamp object with toDate method
                          dateString = decision.createdAt.toDate().toLocaleString();
                        }
                      }
                    } catch (e) {
                      console.error('Error formatting date:', e);
                    }
                  %>
                  <%= dateString %>
                </div>
              </div>
              <div class="chat-stats">
                <div class="stat">
                  <span>💬</span>
                  <span><%= decision.messages ? decision.messages.length : 0 %> messages</span>
                </div>
                <% if (decision.step) { %>
                  <span class="badge"><%= decision.step %></span>
                <% } %>
              </div>
            </div>
            
            <% if (decision.preview && decision.preview.length > 100) { %>
              <div class="chat-preview">
                <%= decision.preview.substring(0, 150) %>...
              </div>
            <% } %>

            <div class="chat-actions" onclick="event.stopPropagation()">
              <a href="/chat?chatId=<%= decision.id %>" class="btn btn-secondary btn-small">
                👁️ View
              </a>
              <button class="btn btn-danger btn-small" onclick="deleteChat('<%= decision.id %>')">
                🗑️ Delete
              </button>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <script>
    function openChat(chatId) {
      // FIXED: Properly escape chatId to prevent XSS
      const encodedChatId = encodeURIComponent(chatId);
      window.location.href = `/chat?chatId=${encodedChatId}`;
    }

    async function deleteChat(chatId) {
      if (!confirm('Are you sure you want to delete this chat? This action cannot be undone.')) {
        return;
      }

      try {
        // FIXED: Properly escape chatId in URL
        const encodedChatId = encodeURIComponent(chatId);
        const response = await fetch(`/chat/${encodedChatId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await response.json();

        if (data.success) {
          alert('Chat deleted successfully!');
          window.location.reload();
        } else {
          alert('Failed to delete chat: ' + (data.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error deleting chat:', error);
        alert('Error deleting chat. Please try again.');
      }
    }

    console.log('📚 History page loaded');
    console.log('💬 Total chats:', `<%= decisions.length %>`);
  </script>
</body>
</html>