<!DOCTYPE html>
<html>
<head>
  <title>Decision Result</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="center">

<h2>✅ Best Decision</h2>

<h1 class="highlight"><%= bestOption %></h1>

<h3>Scores</h3>
<ul>
  <% Object.keys(scores).forEach(opt => { %>
    <li><strong><%= opt %></strong>: <%= scores[opt] %></li>
  <% }) %>
</ul>

<a href="/chat" class="btn">New Decision</a>
<a href="/history" class="btn secondary">View History</a>

</body>
</html>
