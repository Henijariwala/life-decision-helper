<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account — Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root{--ivory:#FFFFF0;--ivory-dark:#F5F5DC;--green:#2D5016;--green-light:#3D6B23;--sage:#8BA888;--white:#FFFFFF;--text:#1A2E0F;--text-light:#5A6B52;}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'DM Sans',sans-serif;background:var(--ivory);min-height:100vh;display:flex;overflow:hidden;}

    /* LEFT */
    .panel-left{width:52%;background:var(--green);position:relative;display:flex;flex-direction:column;justify-content:center;padding:3.5rem 4rem;overflow:hidden;}
    .mesh{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 50% at 70% 30%,rgba(139,168,136,.2) 0%,transparent 70%),radial-gradient(ellipse 50% 60% at 20% 80%,rgba(255,255,240,.06) 0%,transparent 70%);animation:meshShift 9s ease-in-out infinite alternate;}
    @keyframes meshShift{from{opacity:.8;transform:scale(1);}to{opacity:1;transform:scale(1.06);}}
    .ring{position:absolute;border-radius:50%;border:1px solid rgba(139,168,136,.18);animation:rr linear infinite;}
    .r1{width:500px;height:500px;bottom:-150px;right:-150px;animation-duration:42s;}
    .r2{width:320px;height:320px;bottom:-80px;right:-60px;border-color:rgba(139,168,136,.1);animation-duration:30s;animation-direction:reverse;}
    .r3{width:640px;height:640px;top:-260px;left:-200px;border-color:rgba(255,255,240,.04);animation-duration:58s;}
    @keyframes rr{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}

    .particles{position:absolute;inset:0;pointer-events:none;z-index:1;}
    .particle{position:absolute;border-radius:50%;background:rgba(139,168,136,.38);animation:fp linear infinite;}
    @keyframes fp{0%{opacity:0;transform:translateY(0) scale(1);}15%{opacity:1;}85%{opacity:.5;}100%{opacity:0;transform:translateY(-140px) scale(.3);}}

    .left-content{position:relative;z-index:3;}
    .step-badge{display:inline-flex;align-items:center;gap:.6rem;padding:.45rem 1rem;background:rgba(255,255,240,.08);border:1px solid rgba(139,168,136,.3);border-radius:100px;margin-bottom:2.5rem;animation:fadeDown .8s cubic-bezier(.22,1,.36,1) .2s both;}
    .step-badge span{font-size:.72rem;color:var(--sage);letter-spacing:.12em;text-transform:uppercase;font-family:'DM Mono',monospace;}
    @keyframes fadeDown{from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);}}

    .hl{font-family:'Cormorant Garamond',serif;font-size:clamp(2.5rem,3.5vw,3.9rem);font-weight:300;color:var(--ivory);line-height:1.1;letter-spacing:-.02em;}
    .hl em{font-style:italic;color:var(--sage);}
    .hl-line{display:block;overflow:hidden;}
    .hl-line span{display:block;animation:lineUp .9s cubic-bezier(.22,1,.36,1) both;}
    .hl-line:nth-child(1) span{animation-delay:.35s;}
    .hl-line:nth-child(2) span{animation-delay:.5s;}
    .hl-line:nth-child(3) span{animation-delay:.65s;}
    @keyframes lineUp{from{transform:translateY(110%);}to{transform:translateY(0);}}

    .tagline{margin-top:1.5rem;font-size:.9rem;color:rgba(255,255,240,.45);font-weight:300;line-height:1.75;max-width:320px;animation:fadeUp .8s ease .85s both;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

    .steps{margin-top:3.5rem;display:flex;flex-direction:column;gap:1.5rem;}
    .step{display:flex;align-items:flex-start;gap:1rem;animation:fadeUp .7s ease both;}
    .step:nth-child(1){animation-delay:1s;}
    .step:nth-child(2){animation-delay:1.12s;}
    .step:nth-child(3){animation-delay:1.24s;}
    .step-num{width:28px;height:28px;border-radius:50%;border:1px solid rgba(139,168,136,.35);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:.7rem;color:var(--sage);flex-shrink:0;margin-top:2px;transition:all .3s;}
    .step:hover .step-num{background:rgba(139,168,136,.2);border-color:var(--sage);}
    .step-text h4{font-size:.875rem;font-weight:500;color:rgba(255,255,240,.8);margin-bottom:.2rem;transition:color .3s;}
    .step-text p{font-size:.78rem;color:rgba(255,255,240,.38);font-weight:300;}
    .step:hover .step-text h4{color:rgba(255,255,240,1);}

    /* RIGHT */
    .panel-right{width:48%;display:flex;align-items:center;justify-content:center;padding:3rem 4rem;overflow-y:auto;position:relative;}
    .panel-right::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(139,168,136,.08) 1px,transparent 1px);background-size:28px 28px;animation:patternDrift 18s linear infinite;pointer-events:none;}
    @keyframes patternDrift{from{background-position:0 0;}to{background-position:28px 28px;}}

    .auth-card{width:100%;max-width:400px;position:relative;z-index:2;animation:cardIn .85s cubic-bezier(.22,1,.36,1) .1s both;}
    @keyframes cardIn{from{opacity:0;transform:translateY(32px) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}

    .greeting{margin-bottom:2.4rem;}
    .greeting-sub{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--sage);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.6rem;animation:fadeUp .6s ease .4s both;}
    .greeting h2{font-family:'Cormorant Garamond',serif;font-size:2.4rem;font-weight:400;color:var(--green);letter-spacing:-.02em;line-height:1.15;animation:fadeUp .7s ease .5s both;}

    #authMessage{display:none;padding:.9rem 1.1rem;border-radius:8px;font-size:.83rem;margin-bottom:1.5rem;border-left:3px solid;}
    #authMessage.show{display:block;animation:shakeIn .4s ease;}
    @keyframes shakeIn{0%,100%{transform:translateX(0);}20%{transform:translateX(-7px);}40%{transform:translateX(5px);}60%{transform:translateX(-3px);}80%{transform:translateX(2px);}}
    #authMessage.error{background:#FEF2F2;border-left-color:#DC2626;color:#991B1B;}
    #authMessage.success{background:#F0FDF4;border-left-color:#16A34A;color:#166534;}

    .field{margin-bottom:1.3rem;animation:fadeUp .6s ease both;}
    .field:nth-of-type(1){animation-delay:.6s;}
    .field:nth-of-type(2){animation-delay:.72s;}
    .field:nth-of-type(3){animation-delay:.84s;}
    .field-label{display:block;font-size:.75rem;font-weight:500;color:var(--text-light);letter-spacing:.06em;text-transform:uppercase;margin-bottom:.5rem;transition:color .2s;}
    .field:focus-within .field-label{color:var(--green);}
    .input-wrap{position:relative;}
    .field-input{width:100%;padding:.9rem 1.1rem;font-size:.95rem;font-family:'DM Sans',sans-serif;background:var(--white);border:1.5px solid var(--ivory-dark);border-radius:8px;color:var(--text);outline:none;transition:border-color .25s,box-shadow .25s,transform .2s;}
    .field-input:focus{border-color:var(--green);box-shadow:0 0 0 4px rgba(45,80,22,.1);transform:translateY(-1px);}
    .field-input::placeholder{color:rgba(90,107,82,.38);}
    .input-line{position:absolute;bottom:0;left:50%;width:0;height:2px;background:var(--green);border-radius:2px;transition:width .35s ease,left .35s ease;}
    .field-input:focus ~ .input-line{width:100%;left:0;}

    /* Strength bar */
    .strength-bar{margin-top:.45rem;height:3px;border-radius:3px;background:var(--ivory-dark);overflow:hidden;}
    .strength-fill{height:100%;border-radius:3px;width:0;transition:width .4s cubic-bezier(.4,0,.2,1),background .4s;}
    .field-hint{margin-top:.38rem;font-size:.72rem;color:var(--text-light);font-family:'DM Mono',monospace;}

    .btn-primary{width:100%;padding:.95rem;background:var(--green);color:var(--ivory);border:none;border-radius:8px;font-size:.88rem;font-weight:500;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;position:relative;overflow:hidden;font-family:'DM Sans',sans-serif;margin-top:.5rem;transition:background .3s,transform .2s,box-shadow .3s;animation:fadeUp .6s ease .96s both;}
    .sheen{position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);transition:left .55s ease;}
    .btn-primary:hover .sheen{left:100%;}
    .btn-primary:hover{background:var(--green-light);transform:translateY(-2px);box-shadow:0 10px 30px rgba(45,80,22,.3);}
    .btn-primary:active{transform:translateY(0);box-shadow:none;}
    .btn-primary.loading{pointer-events:none;opacity:.7;}
    .btn-primary.loading .btn-text{opacity:0;}
    .btn-primary.loading::before{content:'';position:absolute;width:18px;height:18px;top:50%;left:50%;margin:-9px 0 0 -9px;border:2px solid rgba(255,255,240,.35);border-top-color:var(--ivory);border-radius:50%;animation:spin .65s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}

    .signin-prompt{margin-top:1.8rem;text-align:center;font-size:.82rem;color:var(--text-light);animation:fadeUp .6s ease 1.1s both;}
    .signin-prompt a{color:var(--green);font-weight:500;text-decoration:none;border-bottom:1px solid var(--sage);padding-bottom:1px;transition:border-color .2s;}
    .signin-prompt a:hover{border-color:var(--green);}

    @media(max-width:840px){body{flex-direction:column;overflow:auto;}.panel-left{width:100%;padding:2.5rem 2rem;min-height:240px;}.panel-right{width:100%;padding:2.5rem 2rem;}.steps{display:none;}}
  </style>
</head>
<body>
  <!-- LEFT -->
  <div class="panel-left">
    <div class="mesh"></div>
    <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>
    <div class="particles" id="particles"></div>
    <div class="left-content">
      <div class="step-badge"><span>New Account</span></div>
      <h1 class="hl">
        <span class="hl-line"><span>Begin your</span></span>
        <span class="hl-line"><span><em>journey</em></span></span>
        <span class="hl-line"><span>today</span></span>
      </h1>
      <p class="tagline">Join thousands who use this space to find clarity in life's hardest moments.</p>
      <div class="steps">
        <div class="step"><div class="step-num">01</div><div class="step-text"><h4>Create your account</h4><p>Secure and private, always yours</p></div></div>
        <div class="step"><div class="step-num">02</div><div class="step-text"><h4>Share what's on your mind</h4><p>Your AI companion listens without judgment</p></div></div>
        <div class="step"><div class="step-num">03</div><div class="step-text"><h4>Gain clarity and act</h4><p>Walk away confident in your choice</p></div></div>
      </div>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="panel-right">
    <div class="auth-card">
      <div class="greeting">
        <p class="greeting-sub">Get started</p>
        <h2>Create your<br>account</h2>
      </div>
      <div id="authMessage"></div>
      <form id="signupForm" onsubmit="return false;">
        <div class="field">
          <label class="field-label" for="email">Email Address</label>
          <div class="input-wrap">
            <input class="field-input" id="email" type="email" placeholder="you@example.com" required autocomplete="email">
            <div class="input-line"></div>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="password">Password</label>
          <div class="input-wrap">
            <input class="field-input" id="password" type="password" placeholder="••••••••" required autocomplete="new-password" minlength="6" oninput="updateStrength(this.value)">
            <div class="input-line"></div>
          </div>
          <div class="strength-bar"><div class="strength-fill" id="sf"></div></div>
          <p class="field-hint">minimum 6 characters</p>
        </div>
        <div class="field">
          <label class="field-label" for="confirmPassword">Confirm Password</label>
          <div class="input-wrap">
            <input class="field-input" id="confirmPassword" type="password" placeholder="••••••••" required autocomplete="new-password" minlength="6">
            <div class="input-line"></div>
          </div>
        </div>
        <button type="submit" class="btn-primary" id="signupBtn" onclick="createAccount()">
          <div class="sheen"></div>
          <span class="btn-text">Create Account</span>
        </button>
      </form>
      <p class="signin-prompt">Already have an account? <a href="/">Sign in</a></p>
    </div>
  </div>

  <script>
    // Particles
    const pc=document.getElementById('particles');
    for(let i=0;i<18;i++){const p=document.createElement('div');p.className='particle';const s=Math.random()*4+2;p.style.cssText=`width:${s}px;height:${s}px;left:${Math.random()*100}%;bottom:${Math.random()*30}%;animation-duration:${Math.random()*9+5}s;animation-delay:${Math.random()*8}s;`;pc.appendChild(p);}

    function updateStrength(v){
      const fill=document.getElementById('sf');
      let pct=0,col='#8BA888';
      if(v.length>=6){pct=35;col='#f59e0b';}
      if(v.length>=10){pct=70;col='#3D6B23';}
      if(v.length>=14&&/[^a-zA-Z0-9]/.test(v)){pct=100;col='#2D5016';}
      fill.style.width=pct+'%';fill.style.background=col;
    }
  </script>

  <script type="module">
    import{initializeApp}from"https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import{getAuth,createUserWithEmailAndPassword}from"https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
    const auth=getAuth(initializeApp({apiKey:"AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",authDomain:"life-decision-helper.firebaseapp.com",projectId:"life-decision-helper"}));
    function showMsg(msg,isErr=true){const el=document.getElementById("authMessage");el.className=`${isErr?'error':'success'} show`;el.innerText=msg;setTimeout(()=>el.classList.remove('show'),5000);}
    window.createAccount=async()=>{
      const e=document.getElementById("email").value.trim(),p=document.getElementById("password").value.trim(),c=document.getElementById("confirmPassword").value.trim(),btn=document.getElementById("signupBtn");
      if(!e||!p||!c){showMsg("Please fill in all fields");return;}
      if(p!==c){showMsg("Passwords do not match");return;}
      if(p.length<6){showMsg("Password must be at least 6 characters");return;}
      btn.classList.add('loading');
      try{const uc=await createUserWithEmailAndPassword(auth,e,p);document.cookie=`token=${await uc.user.getIdToken()}; path=/`;showMsg("✓ Account created! Redirecting…",false);setTimeout(()=>window.location.href="/chat",1500);}
      catch(err){btn.classList.remove('loading');let m=err.message;if(err.code==='auth/email-already-in-use')m="This email is already registered";else if(err.code==='auth/invalid-email')m="Please enter a valid email address";else if(err.code==='auth/weak-password')m="Password is too weak";showMsg(m);}
    };
    document.getElementById('signupForm').addEventListener('keypress',e=>{if(e.key==='Enter')window.createAccount();});
  </script>
</body>
</html>
