<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In - Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ivory: #FFFFF0;
      --ivory-dark: #F5F5DC;
      --green: #2D5016;
      --green-light: #3D6B23;
      --green-soft: #4A7C2F;
      --sage: #8BA888;
      --white: #FFFFFF;
      --text: #1A2E0F;
      --text-light: #5A6B52;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Work Sans', sans-serif;
      background: var(--ivory);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      position: relative;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: 
        radial-gradient(circle at 20% 30%, rgba(138, 168, 136, 0.15) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(45, 80, 22, 0.08) 0%, transparent 40%);
      pointer-events: none;
    }

    .container {
      max-width: 480px;
      width: 100%;
      position: relative;
      z-index: 1;
      animation: fadeInUp 0.8s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .header {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .logo {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      display: inline-block;
      animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-weight: 600;
      color: var(--green);
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }

    .subtitle {
      font-size: 1rem;
      color: var(--text-light);
      font-weight: 300;
      letter-spacing: 0.05em;
      text-transform: lowercase;
    }

    .card {
      background: var(--white);
      border-radius: 2px;
      padding: 3rem 2.5rem;
      box-shadow: 
        0 1px 3px rgba(45, 80, 22, 0.05),
        0 10px 40px rgba(45, 80, 22, 0.08);
      border: 1px solid var(--sage);
      position: relative;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--sage), var(--green), var(--sage));
    }

    #authMessage {
      padding: 1rem 1.2rem;
      border-radius: 2px;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      display: none;
      animation: slideDown 0.3s ease;
      border-left: 3px solid;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    #authMessage.show {
      display: block;
    }

    #authMessage.error {
      background: #FEF2F2;
      border-left-color: #DC2626;
      color: #991B1B;
    }

    #authMessage.success {
      background: #F0FDF4;
      border-left-color: #16A34A;
      color: #166534;
    }

    .form-group {
      position: relative;
      margin-bottom: 1.8rem;
    }

    .input-wrapper {
      position: relative;
    }

    input {
      width: 100%;
      padding: 1rem 1.2rem;
      font-size: 0.95rem;
      font-family: 'Work Sans', sans-serif;
      background: var(--ivory);
      border: 1.5px solid var(--sage);
      border-radius: 2px;
      color: var(--text);
      transition: all 0.3s ease;
      outline: none;
    }

    input:focus {
      border-color: var(--green);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.1);
    }

    input:focus + label,
    input:not(:placeholder-shown) + label {
      transform: translateY(-140%) scale(0.85);
      color: var(--green);
      font-weight: 500;
      background: var(--white);
    }

    label {
      position: absolute;
      left: 1.2rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.95rem;
      color: var(--text-light);
      pointer-events: none;
      transition: all 0.3s ease;
      padding: 0 0.4rem;
      background: var(--ivory);
    }

    .btn-primary {
      width: 100%;
      padding: 1.1rem;
      font-size: 0.95rem;
      font-weight: 500;
      font-family: 'Work Sans', sans-serif;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border: none;
      border-radius: 2px;
      cursor: pointer;
      background: var(--green);
      color: var(--white);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s;
    }

    .btn-primary:hover {
      background: var(--green-light);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(45, 80, 22, 0.25);
    }

    .btn-primary:hover::before {
      left: 100%;
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 2rem 0;
      color: var(--text-light);
      font-size: 0.875rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--sage);
    }

    .divider span {
      padding: 0 1.5rem;
      font-weight: 300;
      letter-spacing: 0.05em;
    }

    .btn-secondary {
      width: 100%;
      padding: 1rem;
      font-size: 0.95rem;
      font-weight: 400;
      font-family: 'Work Sans', sans-serif;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border: 1.5px solid var(--sage);
      border-radius: 2px;
      cursor: pointer;
      background: transparent;
      color: var(--green);
      transition: all 0.3s ease;
    }

    .btn-secondary:hover {
      background: var(--ivory);
      border-color: var(--green);
      transform: translateY(-1px);
    }

    @media (max-width: 480px) {
      body {
        padding: 1rem;
      }

      h1 {
        font-size: 2.5rem;
      }

      .card {
        padding: 2.5rem 2rem;
      }
    }

    .btn-primary.loading {
      pointer-events: none;
      opacity: 0.7;
    }

    .btn-primary.loading::after {
      content: '';
      position: absolute;
      width: 18px;
      height: 18px;
      top: 50%;
      left: 50%;
      margin-left: -9px;
      margin-top: -9px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">🧭</div>
      <h1>Life Decision Helper</h1>
      <p class="subtitle">clarity in every choice</p>
    </div>

    <div class="card">
      <div id="authMessage"></div>

      <form id="loginForm" onsubmit="return false;">
        <div class="form-group">
          <div class="input-wrapper">
            <input 
              id="email" 
              type="email" 
              placeholder=" "
              required
              autocomplete="email"
            />
            <label for="email">Email Address</label>
          </div>
        </div>

        <div class="form-group">
          <div class="input-wrapper">
            <input 
              id="password" 
              type="password" 
              placeholder=" "
              required
              autocomplete="current-password"
            />
            <label for="password">Password</label>
          </div>
        </div>

        <button type="submit" class="btn-primary" id="loginBtn" onclick="login()">
          Sign In
        </button>
      </form>

      <div class="divider">
        <span>new here?</span>
      </div>

      <button class="btn-secondary" onclick="window.location.href='/Signup'">
        Create Account
      </button>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import {
      getAuth,
      signInWithEmailAndPassword
    } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",
      authDomain: "life-decision-helper.firebaseapp.com",
      projectId: "life-decision-helper"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    function showMessage(msg, isError = true) {
      const el = document.getElementById("authMessage");
      el.className = `${isError ? 'error' : 'success'} show`;
      el.innerText = msg;
      
      setTimeout(() => {
        el.classList.remove('show');
      }, 5000);
    }

    window.login = async () => {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const btn = document.getElementById("loginBtn");

      if (!email || !password) {
        showMessage("Please fill in all fields");
        return;
      }

      btn.classList.add('loading');
      btn.textContent = '';

      try {
        const userCred = await signInWithEmailAndPassword(auth, email, password);
        const token = await userCred.user.getIdToken();

        document.cookie = `token=${token}; path=/`;
        
        showMessage("✓ Signing in...", false);
        
        setTimeout(() => {
          window.location.href = "/chat";
        }, 800);
      } catch (err) {
        btn.classList.remove('loading');
        btn.textContent = 'Sign In';
        
        let errorMessage = err.message;
        
        if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password') {
          errorMessage = "Invalid email or password";
        } else if (err.code === 'auth/invalid-email') {
          errorMessage = "Please enter a valid email address";
        } else if (err.code === 'auth/too-many-requests') {
          errorMessage = "Too many failed attempts. Try again later";
        }
        
        showMessage(errorMessage);
      }
    };

    document.getElementById('loginForm').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        login();
      }
    });
  </script>
</body>
</html>
