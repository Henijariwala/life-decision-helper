<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Life Decision Helper — Sign In</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --ivory: #FFFFF0;
      --ivory-dark: #F5F5DC;
      --green: #2D5016;
      --green-light: #3D6B23;
      --green-soft: #4A7C2F;
      --sage: #8BA888;
      --sage-light: rgba(139, 168, 136, 0.25);
      --white: #FFFFFF;
      --text: #1A2E0F;
      --text-light: #5A6B52;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--ivory);
      min-height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* ── LEFT PANEL ── */
    .panel-left {
      width: 52%;
      background: var(--green);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 3.5rem 4rem;
      overflow: hidden;
    }

    .panel-left::after {
      content: '';
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(ellipse at 30% 20%, rgba(139,168,136,0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 80%, rgba(255,255,240,0.06) 0%, transparent 50%);
      pointer-events: none;
    }

    /* Large decorative organic ring */
    .ring {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(139,168,136,0.25);
    }
    .ring-1 { width: 560px; height: 560px; top: -120px; right: -200px; }
    .ring-2 { width: 380px; height: 380px; top: -40px; right: -100px; border-color: rgba(139,168,136,0.15); }
    .ring-3 { width: 700px; height: 700px; bottom: -280px; left: -200px; border-color: rgba(255,255,240,0.06); }

    /* Decorative dots grid */
    .dots {
      position: absolute;
      bottom: 4rem;
      right: 3.5rem;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }
    .dot {
      width: 3px; height: 3px;
      border-radius: 50%;
      background: rgba(139,168,136,0.4);
    }

    .left-brand {
      position: relative;
      z-index: 2;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.45rem 1rem;
      background: rgba(255,255,240,0.08);
      border: 1px solid rgba(139,168,136,0.3);
      border-radius: 100px;
      margin-bottom: 3rem;
    }
    .brand-badge span { 
      font-size: 0.72rem; 
      color: var(--sage); 
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-family: 'DM Mono', monospace;
    }
    .brand-badge-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--sage);
      animation: pulse 2.5s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { opacity:1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.7); }
    }

    .left-headline {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.8rem, 4vw, 4.2rem);
      font-weight: 300;
      color: var(--ivory);
      line-height: 1.12;
      letter-spacing: -0.02em;
    }
    .left-headline em {
      font-style: italic;
      color: var(--sage);
    }

    .left-tagline {
      margin-top: 1.5rem;
      font-size: 0.95rem;
      color: rgba(255,255,240,0.5);
      font-weight: 300;
      line-height: 1.7;
      max-width: 300px;
    }

    .left-features {
      position: relative;
      z-index: 2;
    }

    .feature-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .feature-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: rgba(255,255,240,0.65);
      font-size: 0.875rem;
      font-weight: 300;
    }
    .feature-icon {
      width: 34px; height: 34px;
      background: rgba(139,168,136,0.12);
      border: 1px solid rgba(139,168,136,0.2);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    /* ── RIGHT PANEL ── */
    .panel-right {
      width: 48%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem 4rem;
      overflow-y: auto;
    }

    .auth-card {
      width: 100%;
      max-width: 400px;
      animation: slideUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(28px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-greeting {
      margin-bottom: 2.8rem;
    }
    .auth-greeting-sub {
      font-family: 'DM Mono', monospace;
      font-size: 0.72rem;
      color: var(--sage);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }
    .auth-greeting h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem;
      font-weight: 400;
      color: var(--green);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    /* Alert message */
    #authMessage {
      display: none;
      padding: 0.9rem 1.1rem;
      border-radius: 6px;
      font-size: 0.83rem;
      margin-bottom: 1.5rem;
      border-left: 3px solid;
      animation: slideDown 0.3s ease;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    #authMessage.show { display: block; }
    #authMessage.error { background: #FEF2F2; border-left-color: #DC2626; color: #991B1B; }
    #authMessage.success { background: #F0FDF4; border-left-color: #16A34A; color: #166534; }

    /* Form fields */
    .field {
      margin-bottom: 1.4rem;
    }
    .field-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-light);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 0.55rem;
    }
    .field-input {
      width: 100%;
      padding: 0.9rem 1.1rem;
      font-size: 0.95rem;
      font-family: 'DM Sans', sans-serif;
      background: var(--white);
      border: 1.5px solid var(--ivory-dark);
      border-radius: 8px;
      color: var(--text);
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    .field-input:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3.5px rgba(45, 80, 22, 0.1);
    }
    .field-input::placeholder { color: rgba(90,107,82,0.4); }

    /* Buttons */
    .btn-primary {
      width: 100%;
      padding: 0.95rem;
      background: var(--green);
      color: var(--ivory);
      border: none;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.25s, transform 0.15s, box-shadow 0.25s;
      position: relative;
      overflow: hidden;
      font-family: 'DM Sans', sans-serif;
      margin-top: 0.5rem;
    }
    .btn-primary:hover {
      background: var(--green-light);
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(45,80,22,0.28);
    }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary.loading { pointer-events: none; opacity: 0.65; }

    .divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 1.8rem 0;
    }
    .divider-line { flex: 1; height: 1px; background: var(--ivory-dark); }
    .divider-text { 
      font-size: 0.75rem; 
      color: var(--text-light); 
      white-space: nowrap;
      font-weight: 300;
    }

    .btn-secondary {
      width: 100%;
      padding: 0.9rem;
      background: transparent;
      color: var(--green);
      border: 1.5px solid var(--ivory-dark);
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'DM Sans', sans-serif;
    }
    .btn-secondary:hover {
      border-color: var(--sage);
      background: var(--sage-light);
    }

    .auth-footer {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.78rem;
      color: var(--text-light);
    }

    @media (max-width: 840px) {
      body { flex-direction: column; overflow: auto; }
      .panel-left { width: 100%; padding: 2.5rem 2rem; min-height: 280px; }
      .panel-right { width: 100%; padding: 2.5rem 2rem; }
      .left-features { display: none; }
      .ring-1, .ring-3 { display: none; }
    }
  </style>
</head>
<body>

  <!-- LEFT PANEL -->
  <div class="panel-left">
    <div class="ring ring-1"></div>
    <div class="ring ring-2"></div>
    <div class="ring ring-3"></div>
    <div class="dots">
      <% for(let i=0;i<25;i++) { %><div class="dot"></div><% } %>
    </div>

    <div class="left-brand">
      <div class="brand-badge">
        <div class="brand-badge-dot"></div>
        <span>Life Decision Helper</span>
      </div>
      <h1 class="left-headline">
        Clarity<br>in every<br><em>choice</em>
      </h1>
      <p class="left-tagline">
        A thoughtful space to navigate life's decisions with confidence and calm.
      </p>
    </div>

    <ul class="left-features feature-list">
      <li class="feature-item">
        <div class="feature-icon">🧭</div>
        Guided decision frameworks
      </li>
      <li class="feature-item">
        <div class="feature-icon">💬</div>
        Empathetic AI conversation
      </li>
      <li class="feature-item">
        <div class="feature-icon">📚</div>
        Full conversation history
      </li>
    </ul>
  </div>

  <!-- RIGHT PANEL -->
  <div class="panel-right">
    <div class="auth-card">
      <div class="auth-greeting">
        <p class="auth-greeting-sub">Welcome back</p>
        <h2>Sign in to<br>your account</h2>
      </div>

      <div id="authMessage"></div>

      <form id="loginForm" onsubmit="return false;">
        <div class="field">
          <label class="field-label" for="email">Email Address</label>
          <input class="field-input" id="email" type="email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="field">
          <label class="field-label" for="password">Password</label>
          <input class="field-input" id="password" type="password" placeholder="••••••••" required autocomplete="current-password">
        </div>

        <button type="submit" class="btn-primary" id="loginBtn" onclick="login()">
          Sign In
        </button>
      </form>

      <div class="divider">
        <div class="divider-line"></div>
        <span class="divider-text">don't have an account?</span>
        <div class="divider-line"></div>
      </div>

      <button class="btn-secondary" onclick="window.location.href='/Signup'">
        Create Account
      </button>

      <p class="auth-footer">Your journey to clarity starts here.</p>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyD4zyIOYaquJ_U9L5iWbPs-Dr-6S7Lfdxg",
      authDomain: "life-decision-helper.firebaseapp.com",
      projectId: "life-decision-helper"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    function showMessage(msg, isError = true) {
      const el = document.getElementById("authMessage");
      el.className = `${isError ? 'error' : 'success'} show`;
      el.innerText = msg;
      setTimeout(() => el.classList.remove('show'), 5000);
    }

    window.login = async () => {
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value.trim();
      const btn = document.getElementById("loginBtn");

      if (!email || !password) { showMessage("Please fill in all fields"); return; }

      btn.classList.add('loading');
      btn.textContent = 'Signing in…';

      try {
        const userCred = await signInWithEmailAndPassword(auth, email, password);
        const token = await userCred.user.getIdToken();
        document.cookie = `token=${token}; path=/`;
        showMessage("✓ Welcome back!", false);
        setTimeout(() => window.location.href = "/chat", 800);
      } catch (err) {
        btn.classList.remove('loading');
        btn.textContent = 'Sign In';
        let msg = "Something went wrong";
        if (err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password') msg = "Invalid email or password";
        else if (err.code === 'auth/invalid-email') msg = "Please enter a valid email";
        else if (err.code === 'auth/too-many-requests') msg = "Too many attempts. Try later";
        showMessage(msg);
      }
    };

    document.getElementById('loginForm').addEventListener('keypress', e => { if (e.key === 'Enter') login(); });
  </script>
</body>
</html>
