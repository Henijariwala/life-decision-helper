<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>History — Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root{--ivory:#FFFFF0;--ivory-dark:#F5F5DC;--green:#2D5016;--green-light:#3D6B23;--sage:#8BA888;--white:#FFFFFF;--text:#1A2E0F;--text-light:#5A6B52;}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'DM Sans',sans-serif;background:var(--ivory);min-height:100vh;}

    /* ══ TOPBAR ══ */
    .topbar{background:var(--white);border-bottom:1px solid rgba(139,168,136,.3);padding:0 2rem;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 1px 12px rgba(45,80,22,.04);animation:topbarIn .5s ease both;}
    @keyframes topbarIn{from{opacity:0;transform:translateY(-100%);}to{opacity:1;transform:translateY(0);}}
    .tl{display:flex;align-items:center;gap:1rem;}
    .tlogo{width:34px;height:34px;background:var(--green);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1rem;transition:transform .3s;cursor:default;}
    .tlogo:hover{transform:rotate(10deg) scale(1.1);}
    .ttitle{font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:600;color:var(--green);letter-spacing:-.01em;}
    .ta{display:flex;align-items:center;gap:.5rem;}
    .nb{display:inline-flex;align-items:center;gap:.4rem;padding:.45rem 1rem;border-radius:6px;font-size:.78rem;font-weight:500;cursor:pointer;transition:all .2s;text-decoration:none;font-family:'DM Sans',sans-serif;letter-spacing:.02em;border:none;}
    .ng{background:transparent;color:var(--text-light);border:1px solid transparent;}
    .ng:hover{background:var(--ivory);color:var(--green);border-color:rgba(139,168,136,.4);}
    .np{background:var(--green);color:var(--ivory);}
    .np:hover{background:var(--green-light);transform:translateY(-1px);}

    /* ══ HERO ══ */
    .hero{background:var(--green);position:relative;overflow:hidden;padding:5rem 2rem;text-align:center;}
    .hero-mesh{position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 20% 50%,rgba(139,168,136,.2) 0%,transparent 70%),radial-gradient(ellipse 50% 60% at 80% 50%,rgba(255,255,240,.06) 0%,transparent 70%);animation:meshShift 9s ease-in-out infinite alternate;}
    @keyframes meshShift{from{opacity:.8;}to{opacity:1;}}
    .hero-ring{position:absolute;border-radius:50%;top:50%;left:50%;transform:translate(-50%,-50%);border:1px solid rgba(139,168,136,.12);animation:expandRing linear infinite;}
    .hr2{width:400px;height:400px;border-color:rgba(139,168,136,.08);animation-duration:6s;animation-delay:0s;}
    .hr3{width:600px;height:600px;border-color:rgba(139,168,136,.05);animation-duration:6s;animation-delay:1.5s;}
    .hr4{width:900px;height:900px;border-color:rgba(139,168,136,.03);animation-duration:6s;animation-delay:3s;}
    @keyframes expandRing{0%{opacity:0;transform:translate(-50%,-50%) scale(.5);}50%{opacity:1;}100%{opacity:0;transform:translate(-50%,-50%) scale(1.5);}}
    .hero-content{position:relative;z-index:3;}
    .hero-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem 1rem;background:rgba(255,255,240,.08);border:1px solid rgba(139,168,136,.3);border-radius:100px;margin-bottom:1.5rem;animation:fadeDown .8s cubic-bezier(.22,1,.36,1) .2s both;}
    .hero-badge span{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--sage);letter-spacing:.12em;text-transform:uppercase;}
    @keyframes fadeDown{from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);}}
    .hero-title{font-family:'Cormorant Garamond',serif;font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--ivory);letter-spacing:-.02em;line-height:1.1;margin-bottom:.75rem;overflow:hidden;}
    .hero-title .hl-line{display:inline-block;overflow:hidden;vertical-align:bottom;}
    .hero-title .hl-line span{display:block;animation:lineUp 1s cubic-bezier(.22,1,.36,1) both;}
    .hero-title .hl-line:nth-child(1) span{animation-delay:.3s;}
    .hero-title .hl-line:nth-child(2) span{animation-delay:.1s;}
    @keyframes lineUp{from{transform:translateY(110%);}to{transform:translateY(0);}}
    .hero-title em{font-style:italic;color:var(--sage);}
    .hero-sub{font-size:.9rem;color:rgba(255,255,240,.45);font-weight:300;letter-spacing:.03em;animation:fadeUp .8s ease .7s both;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

    /* ══ MAIN ══ */
    .main{max-width:1150px;margin:0 auto;padding:3rem 2rem;}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:2.5rem;}
    .stat{background:var(--white);border:1px solid rgba(139,168,136,.28);border-radius:10px;padding:1.8rem;text-align:center;position:relative;overflow:hidden;animation:fadeUp .6s ease both;}
    .stat:nth-child(1){animation-delay:.2s;}.stat:nth-child(2){animation-delay:.32s;}.stat:nth-child(3){animation-delay:.44s;}
    .stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--sage),var(--green),var(--sage));animation:lineShimmer 3s ease-in-out infinite;}
    @keyframes lineShimmer{0%,100%{opacity:.6;}50%{opacity:1;}}
    .stat-val{font-family:'Cormorant Garamond',serif;font-size:2.8rem;font-weight:400;color:var(--green);line-height:1;margin-bottom:.4rem;}
    .stat-lbl{font-size:.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.09em;font-family:'DM Mono',monospace;}
    .sec-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;}
    .sec-title{font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:400;color:var(--green);letter-spacing:-.01em;}
    .sec-count{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--text-light);letter-spacing:.08em;}

    /* ── Cards ── */
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem;}
    .card{background:var(--white);border:1px solid rgba(139,168,136,.28);border-radius:10px;cursor:pointer;overflow:hidden;position:relative;animation:cardIn .55s cubic-bezier(.22,1,.36,1) both;transform-style:preserve-3d;transition:box-shadow .3s;}
    .card:nth-child(1){animation-delay:.1s;}.card:nth-child(2){animation-delay:.18s;}.card:nth-child(3){animation-delay:.26s;}.card:nth-child(4){animation-delay:.34s;}.card:nth-child(5){animation-delay:.42s;}.card:nth-child(6){animation-delay:.5s;}.card:nth-child(n+7){animation-delay:.55s;}
    @keyframes cardIn{from{opacity:0;transform:translateY(22px) scale(.97);}to{opacity:1;transform:translateY(0) scale(1);}}
    .card-strip{height:3px;background:linear-gradient(90deg,var(--sage),var(--green));transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.22,1,.36,1);}
    .card:hover .card-strip{transform:scaleX(1);}
    .card-body{padding:1.5rem;}
    .card-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;}
    .card-icon{width:40px;height:40px;background:var(--ivory);border:1px solid rgba(139,168,136,.28);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:transform .3s,background .3s;}
    .card:hover .card-icon{background:rgba(139,168,136,.15);transform:rotate(8deg) scale(1.1);}
    .card-dt{text-align:right;}
    .card-dt-main{font-size:.8rem;font-weight:500;color:var(--green);display:block;}
    .card-dt-time{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--text-light);display:block;margin-top:.15rem;}
    .card-prev{font-size:.875rem;color:var(--text);line-height:1.65;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:4.3em;font-weight:300;transition:color .2s;}
    .card:hover .card-prev{color:var(--green);}
    .card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:1.2rem;padding-top:1rem;border-top:1px solid rgba(139,168,136,.18);}
    .card-meta{display:flex;align-items:center;gap:.4rem;font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text-light);}
    .meta-dot{width:4px;height:4px;border-radius:50%;background:var(--sage);}

    /* ── Action buttons — KEY FIX: pointer-events on buttons, not wrapper ── */
    .card-actions{display:flex;gap:.35rem;}
    .act-btn{
      width:30px;height:30px;border-radius:6px;
      border:1px solid rgba(139,168,136,.28);
      background:transparent;cursor:pointer;
      display:flex;align-items:center;justify-content:center;
      transition:all .2s;color:var(--text-light);
      /* FIX: ensure button is always clickable above card */
      position:relative;z-index:10;
    }
    .act-btn:hover{background:var(--ivory);border-color:var(--sage);transform:scale(1.1);}
    .act-btn.del:hover{background:#FEF2F2;border-color:#FECACA;}
    .act-btn svg{pointer-events:none;}

    .card::after{content:'';position:absolute;inset:0;border-radius:10px;box-shadow:inset 0 0 0 1.5px rgba(45,80,22,0);transition:box-shadow .3s;}
    .card:hover::after{box-shadow:inset 0 0 0 1.5px rgba(45,80,22,.15);}
    .card:hover{box-shadow:0 14px 40px rgba(45,80,22,.13);}

    /* Empty */
    .empty{grid-column:1/-1;text-align:center;padding:5rem 2rem;background:var(--white);border:1px solid rgba(139,168,136,.28);border-radius:10px;animation:fadeUp .6s ease .2s both;}
    .empty-icon{font-size:3.5rem;margin-bottom:1.5rem;display:block;animation:floatIcon 4s ease-in-out infinite;}
    @keyframes floatIcon{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
    .empty-title{font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:400;color:var(--green);margin-bottom:.5rem;}
    .empty-sub{font-size:.88rem;color:var(--text-light);margin-bottom:2rem;font-weight:300;}

    /* ── Delete overlay ── */
    .del-overlay{
      position:fixed;inset:0;
      background:rgba(26,46,15,.45);
      backdrop-filter:blur(5px);
      z-index:9999;         /* high enough to cover everything */
      display:none;
      align-items:center;justify-content:center;
    }
    .del-overlay.show{display:flex;animation:overlayIn .2s ease;}
    @keyframes overlayIn{from{opacity:0;}to{opacity:1;}}
    .del-dialog{
      background:var(--white);border-radius:14px;
      padding:2.2rem 2rem;max-width:360px;width:90%;
      text-align:center;
      box-shadow:0 24px 64px rgba(45,80,22,.25);
      animation:dialogIn .28s cubic-bezier(.22,1,.36,1);
    }
    @keyframes dialogIn{from{opacity:0;transform:scale(.88) translateY(20px);}to{opacity:1;transform:scale(1) translateY(0);}}
    .del-icon{font-size:2.5rem;margin-bottom:.75rem;display:block;}
    .del-dialog h3{font-family:'Cormorant Garamond',serif;font-size:1.6rem;color:var(--green);margin-bottom:.4rem;}
    .del-dialog p{font-size:.84rem;color:var(--text-light);margin-bottom:1.75rem;line-height:1.6;}
    .del-btns{display:flex;gap:.75rem;justify-content:center;}
    .del-cancel,.del-confirm{
      padding:.72rem 1.5rem;border-radius:8px;
      font-size:.85rem;font-weight:500;
      cursor:pointer;font-family:'DM Sans',sans-serif;
      border:none;transition:all .2s;
    }
    .del-cancel{background:var(--ivory);color:var(--text);border:1.5px solid var(--ivory-dark);}
    .del-cancel:hover{border-color:var(--sage);}
    .del-confirm{background:#DC2626;color:#fff;min-width:90px;}
    .del-confirm:hover{background:#B91C1C;transform:translateY(-1px);}
    .del-confirm.loading{opacity:.7;pointer-events:none;}

    /* Toast */
    .toast{
      position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(20px);
      background:var(--green);color:var(--ivory);
      padding:.65rem 1.4rem;border-radius:8px;font-size:.82rem;
      opacity:0;transition:all .3s;pointer-events:none;z-index:99999;
      font-family:'DM Sans',sans-serif;
    }
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .toast.error-toast{background:#DC2626;}

    @media(max-width:768px){.stats{grid-template-columns:1fr 1fr;}.grid{grid-template-columns:1fr;}.topbar{padding:0 1rem;}.hero{padding:3rem 1.5rem;}.main{padding:2rem 1.25rem;}}
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <nav class="topbar">
    <div class="tl">
      <div class="tlogo">📚</div>
      <span class="ttitle">History</span>
    </div>
    <div class="ta">
      <a href="/chat" class="nb np">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>New Chat
      </a>
      <form action="/logout" method="POST" style="display:inline">
        <button type="submit" class="nb ng">Logout</button>
      </form>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-mesh"></div>
    <div class="hero-ring hr2"></div>
    <div class="hero-ring hr3"></div>
    <div class="hero-ring hr4"></div>
    <div class="hero-content">
      <div class="hero-badge"><span>Your Journey</span></div>
      <h1 class="hero-title">
        <span class="hl-line"><span>Past&nbsp;</span></span><span class="hl-line"><span><em>Conversations</em></span></span>
      </h1>
      <p class="hero-sub">Revisit the moments that shaped your decisions</p>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">
    <% if(decisions && decisions.length > 0){ %>

      <div class="stats">
        <div class="stat">
          <div class="stat-val" data-target="<%= decisions.length %>">0</div>
          <div class="stat-lbl">Conversations</div>
        </div>
        <div class="stat">
          <div class="stat-val" data-target="<%= decisions.reduce((a,d)=>a+((d.messages&&d.messages.length)||0),0) %>">0</div>
          <div class="stat-lbl">Total Messages</div>
        </div>
        <div class="stat">
          <div class="stat-val" data-target="<%= Math.round(decisions.reduce((a,d)=>a+((d.messages&&d.messages.length)||0),0)/Math.max(decisions.length,1)) %>">0</div>
          <div class="stat-lbl">Avg per Chat</div>
        </div>
      </div>

      <div class="sec-header">
        <h2 class="sec-title">All Conversations</h2>
        <span class="sec-count"><%= decisions.length %> TOTAL</span>
      </div>

      <div class="grid" id="cardsGrid">
        <% decisions.forEach(function(d){ %>
          <div class="card" data-id="<%= d.id %>">
            <div class="card-strip"></div>
            <div class="card-body">
              <div class="card-head">
                <div class="card-icon">🌿</div>
                <div class="card-dt">
                  <% if(d.createdAt){ %>
                    <span class="card-dt-main"><%= new Date(d.createdAt).toLocaleDateString('en-IN',{month:'short',day:'numeric',year:'numeric',timeZone:'Asia/Kolkata'}) %></span>
                    <span class="card-dt-time"><%= new Date(d.createdAt).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true,timeZone:'Asia/Kolkata'}) %></span>
                  <% } else { %>
                    <span class="card-dt-main">Recent</span>
                  <% } %>
                </div>
              </div>
              <p class="card-prev"><%= d.preview || 'No preview available' %></p>
              <div class="card-foot">
                <div class="card-meta">
                  <div class="meta-dot"></div>
                  <span><%= (d.messages && d.messages.length) || 0 %> messages</span>
                </div>
                <!-- FIX: buttons use data attributes, no inline onclick on card -->
                <div class="card-actions">
                  <button class="act-btn open-btn" data-id="<%= d.id %>" title="Open">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </button>
                  <button class="act-btn del del-btn" data-id="<%= d.id %>" title="Delete">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <div class="grid">
        <div class="empty">
          <span class="empty-icon">🌿</span>
          <h2 class="empty-title">No Conversations Yet</h2>
          <p class="empty-sub">Your journey begins with a single question</p>
          <a href="/chat" class="nb np" style="display:inline-flex;padding:.7rem 1.5rem;font-size:.85rem;">Start Your First Chat</a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Delete confirmation dialog -->
  <div class="del-overlay" id="delOverlay">
    <div class="del-dialog">
      <span class="del-icon">🗑️</span>
      <h3>Delete Conversation</h3>
      <p>This action cannot be undone.<br>Are you sure you want to delete this conversation?</p>
      <div class="del-btns">
        <button class="del-cancel" id="delCancelBtn">Cancel</button>
        <button class="del-confirm" id="delConfirmBtn">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast notification -->
  <div class="toast" id="toast"></div>

  <script>
    // ─── Toast helper ──────────────────────────────────────────
    function showToast(msg, isError = false) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast' + (isError ? ' error-toast' : '');
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 3000);
    }

    // ─── Card click → open chat ────────────────────────────────
    // Use event delegation on grid so buttons don't bubble up
    const grid = document.getElementById('cardsGrid');
    if (grid) {
      grid.addEventListener('click', function(e) {
        // Open button
        const openBtn = e.target.closest('.open-btn');
        if (openBtn) {
          e.stopPropagation();
          window.location.href = `/chat?chatId=${openBtn.dataset.id}`;
          return;
        }
        // Delete button
        const delBtn = e.target.closest('.del-btn');
        if (delBtn) {
          e.stopPropagation();
          showDeleteDialog(delBtn.dataset.id);
          return;
        }
        // Card body click → open chat
        const card = e.target.closest('.card');
        if (card) {
          window.location.href = `/chat?chatId=${card.dataset.id}`;
        }
      });
    }

    // ─── Delete dialog ─────────────────────────────────────────
    let pendingId = null;

    function showDeleteDialog(id) {
      pendingId = id;
      document.getElementById('delOverlay').classList.add('show');
    }

    function closeDeleteDialog() {
      document.getElementById('delOverlay').classList.remove('show');
      const btn = document.getElementById('delConfirmBtn');
      btn.classList.remove('loading');
      btn.textContent = 'Delete';
      pendingId = null;
    }

    // Cancel button
    document.getElementById('delCancelBtn').addEventListener('click', closeDeleteDialog);

    // Click outside dialog to close
    document.getElementById('delOverlay').addEventListener('click', function(e) {
      if (e.target === this) closeDeleteDialog();
    });

    // Confirm delete — KEY FIX: credentials: 'include' sends the auth cookie
    document.getElementById('delConfirmBtn').addEventListener('click', async function() {
      if (!pendingId) return;

      this.classList.add('loading');
      this.textContent = 'Deleting…';

      try {
        const res = await fetch(`/chat/${pendingId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include'   // ← sends auth cookie with the request
        });

        // Handle non-JSON responses gracefully
        const text = await res.text();
        let data;
        try { data = JSON.parse(text); } catch(_) { data = {}; }

        if (res.ok && data.success) {
          // Remove card from DOM without full reload
          const card = grid.querySelector(`.card[data-id="${pendingId}"]`);
          if (card) {
            card.style.transition = 'all .35s ease';
            card.style.opacity = '0';
            card.style.transform = 'scale(.95)';
            setTimeout(() => {
              card.remove();
              updateStats();
            }, 350);
          }
          closeDeleteDialog();
          showToast('✓ Conversation deleted');
        } else {
          closeDeleteDialog();
          showToast(data.error || 'Failed to delete. Please try again.', true);
        }
      } catch (err) {
        console.error('Delete error:', err);
        closeDeleteDialog();
        showToast('Network error. Please try again.', true);
      }
    });

    // ─── Update stats after delete ─────────────────────────────
    function updateStats() {
      const remaining = grid ? grid.querySelectorAll('.card').length : 0;
      const countEl = document.querySelector('.sec-count');
      if (countEl) countEl.textContent = `${remaining} TOTAL`;

      // If no cards left, reload to show empty state
      if (remaining === 0) {
        setTimeout(() => window.location.reload(), 400);
      }
    }

    // ─── 3D card tilt ──────────────────────────────────────────
    if (grid) {
      grid.querySelectorAll('.card').forEach(card => {
        card.addEventListener('mousemove', e => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width  - 0.5;
          const y = (e.clientY - r.top)  / r.height - 0.5;
          card.style.transform = `perspective(600px) rotateY(${x*5}deg) rotateX(${-y*5}deg) translateY(-3px)`;
        });
        card.addEventListener('mouseleave', () => { card.style.transform = ''; });
      });
    }

    // ─── Count-up stats ────────────────────────────────────────
    function countUp(el, target, duration = 1100) {
      const start = performance.now();
      const tick = now => {
        const p = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(ease * target);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = target;
      };
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          countUp(el, parseInt(el.dataset.target));
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.stat-val[data-target]').forEach(el => observer.observe(el));
  </script>
</body>
</html>
