<!DOCTYPE html>
<html>
<head>
  <title>Decision History</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<h2>📜 Decision History</h2>

<% if (decisions.length === 0) { %>
  <p>No decisions yet.</p>
<% } %>

<% decisions.forEach(d => { %>
  <div class="card">
    <p><strong>Best Option:</strong> <%= d.bestOption %></p>
    <p><strong>Options:</strong> <%= d.options.join(", ") %></p>
    <small><%= new Date(d.createdAt.seconds * 1000).toLocaleString() %></small>
  </div>
<% }) %>

<a href="/" class="link">← Home</a>

</body>
</html>
