<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Decision Chat</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .header {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .header h1 {
      color: white;
      font-size: 1.5rem;
    }

    .header-actions {
      display: flex;
      gap: 1rem;
    }

    .btn {
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.3s;
      text-decoration: none;
      display: inline-block;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.2);
      color: white;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .chat-container {
      flex: 1;
      max-width: 900px;
      width: 100%;
      margin: 2rem auto;
      padding: 0 1rem;
      display: flex;
      flex-direction: column;
    }

    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 12px;
      margin-bottom: 1rem;
      min-height: 400px;
      max-height: 600px;
    }

    .message {
      margin-bottom: 1rem;
      padding: 1rem;
      border-radius: 12px;
      max-width: 80%;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      margin-left: auto;
      text-align: right;
    }

    .message.assistant {
      background: #f0f0f0;
      color: #333;
      margin-right: auto;
    }

    .message.error {
      background: #fee;
      color: #c33;
      border-left: 4px solid #c33;
    }

    .message-text {
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }

    .message-time {
      font-size: 0.75rem;
      opacity: 0.7;
    }

    .input-container {
      background: rgba(255, 255, 255, 0.95);
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .input-form {
      display: flex;
      gap: 1rem;
    }

    .message-input {
      flex: 1;
      padding: 1rem;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.3s;
    }

    .message-input:focus {
      outline: none;
      border-color: #667eea;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 1rem 2rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      border-radius: 8px;
      transition: transform 0.2s;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #999;
    }

    .empty-state h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .empty-state p {
      font-size: 1rem;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>💬 Decision Helper Chat</h1>
    <div class="header-actions">
      <a href="/history" class="btn btn-secondary">History</a>
      <form action="/logout" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-secondary">Logout</button>
      </form>
    </div>
  </div>

  <div class="chat-container">
    <div class="messages" id="messagesContainer">
      <% if (messages && messages.length > 0) { %>
        <% messages.forEach(function(msg) { %>
          <div class="message <%= msg.role %> <%= msg.isError ? 'error' : '' %>">
            <div class="message-text"><%= msg.text %></div>
            <div class="message-time"><%= msg.timestamp || '' %></div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <h2>👋 Welcome!</h2>
          <p>Start a conversation by typing a message below.</p>
        </div>
      <% } %>
    </div>

    <div class="input-container">
      <form class="input-form" method="POST" action="/chat" id="chatForm">
        <!-- Hidden field for chat ID -->
        <input type="hidden" name="chatId" value="<%= chatId || '' %>">
        
        <!-- Hidden field for messages history -->
        <input type="hidden" name="messages" id="messagesField" value='<%- JSON.stringify(messages || []) %>'>
        
        <!-- Message input -->
        <input 
          type="text" 
          name="message" 
          id="messageInput"
          class="message-input" 
          placeholder="Type your message..." 
          required
          autocomplete="off"
        >
        
        <!-- Submit button -->
        <button type="submit" class="btn btn-primary" id="sendButton">Send</button>
      </form>
    </div>
  </div>

  <script>
    // Auto-scroll to bottom of messages
    const messagesContainer = document.getElementById('messagesContainer');
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // Form handling
    const form = document.getElementById('chatForm');
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');

    form.addEventListener('submit', function(e) {
      // Validate message is not empty
      const message = messageInput.value.trim();
      
      if (!message) {
        e.preventDefault();
        alert('Please enter a message');
        return false;
      }

      // Disable button to prevent double submission
      sendButton.disabled = true;
      sendButton.textContent = 'Sending...';
    });

    // Focus on input when page loads
    messageInput.focus();

    // Allow Enter to submit (without Shift)
    messageInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.submit();
      }
    });
  </script>
</body>
</html>
