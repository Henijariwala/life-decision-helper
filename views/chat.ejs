<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conversation — Life Decision Helper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --ivory: #FFFFF0;
      --ivory-dark: #F5F5DC;
      --green: #2D5016;
      --green-light: #3D6B23;
      --green-soft: #4A7C2F;
      --sage: #8BA888;
      --sage-light: rgba(139, 168, 136, 0.18);
      --white: #FFFFFF;
      --text: #1A2E0F;
      --text-light: #5A6B52;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--ivory);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ══ TOPBAR ══ */
    .topbar {
      background: var(--white);
      border-bottom: 1px solid rgba(139,168,136,0.3);
      padding: 0 2rem;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 1px 12px rgba(45,80,22,0.04);
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .topbar-logo {
      width: 34px; height: 34px;
      background: var(--green);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
    }

    .topbar-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--green);
      letter-spacing: -0.01em;
    }

    .topbar-sep {
      width: 1px;
      height: 18px;
      background: rgba(139,168,136,0.4);
    }

    .chat-id-badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.68rem;
      color: var(--text-light);
      letter-spacing: 0.05em;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .nav-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 1rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      font-family: 'DM Sans', sans-serif;
      letter-spacing: 0.02em;
      border: none;
    }

    .nav-btn-ghost {
      background: transparent;
      color: var(--text-light);
      border: 1px solid transparent;
    }
    .nav-btn-ghost:hover {
      background: var(--ivory);
      color: var(--green);
      border-color: rgba(139,168,136,0.4);
    }

    .nav-btn-primary {
      background: var(--green);
      color: var(--ivory);
    }
    .nav-btn-primary:hover {
      background: var(--green-light);
    }

    /* ══ MAIN LAYOUT ══ */
    .chat-layout {
      flex: 1;
      display: flex;
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      padding: 0 1.5rem;
      gap: 1.5rem;
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    /* ── Sidebar ── */
    .sidebar {
      width: 240px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .sidebar-card {
      background: var(--white);
      border: 1px solid rgba(139,168,136,0.35);
      border-radius: 10px;
      padding: 1.4rem;
    }

    .sidebar-card-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      color: var(--text-light);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .prompt-chip {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.65rem 0.85rem;
      background: var(--ivory);
      border: 1px solid rgba(139,168,136,0.3);
      border-radius: 6px;
      font-size: 0.78rem;
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 0.5rem;
      line-height: 1.4;
      font-family: 'DM Sans', sans-serif;
    }
    .prompt-chip:last-child { margin-bottom: 0; }
    .prompt-chip:hover {
      background: var(--green);
      color: var(--ivory);
      border-color: var(--green);
      transform: translateX(3px);
    }

    .sidebar-tip {
      font-size: 0.78rem;
      color: var(--text-light);
      line-height: 1.6;
      font-weight: 300;
    }

    /* ── Main chat area ── */
    .chat-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .messages-panel {
      flex: 1;
      background: var(--white);
      border: 1px solid rgba(139,168,136,0.35);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      margin-bottom: 1rem;
      position: relative;
    }

    /* Gradient top accent */
    .messages-panel::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--sage) 0%, var(--green) 50%, var(--sage) 100%);
      z-index: 2;
    }

    .messages-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 2rem 1.8rem;
      scroll-behavior: smooth;
      min-height: 400px;
      max-height: calc(100vh - 280px);
    }

    .messages-scroll::-webkit-scrollbar { width: 4px; }
    .messages-scroll::-webkit-scrollbar-track { background: transparent; }
    .messages-scroll::-webkit-scrollbar-thumb { background: rgba(139,168,136,0.4); border-radius: 4px; }
    .messages-scroll { scrollbar-width: thin; scrollbar-color: rgba(139,168,136,0.4) transparent; }

    /* ── Messages ── */
    .msg {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.75rem;
      animation: msgIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes msgIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .msg.user { align-items: flex-end; }
    .msg.assistant { align-items: flex-start; }

    .msg-row {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .msg.user .msg-row { flex-direction: row-reverse; }

    .msg-avatar {
      width: 30px; height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      flex-shrink: 0;
    }
    .msg.user .msg-avatar {
      background: var(--green);
    }
    .msg.assistant .msg-avatar {
      background: var(--ivory-dark);
      border: 1px solid rgba(139,168,136,0.4);
    }

    .msg-bubble {
      max-width: 72%;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      font-size: 0.915rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
    .msg.user .msg-bubble {
      background: var(--green);
      color: var(--ivory);
      border-bottom-right-radius: 3px;
    }
    .msg.assistant .msg-bubble {
      background: var(--ivory);
      color: var(--text);
      border: 1px solid rgba(139,168,136,0.3);
      border-bottom-left-radius: 3px;
    }
    .msg.error .msg-bubble {
      background: #FEF2F2;
      color: #991B1B;
      border: 1px solid #FECACA;
    }

    .msg-time {
      font-family: 'DM Mono', monospace;
      font-size: 0.62rem;
      color: var(--text-light);
      margin-top: 0.45rem;
      padding: 0 0.25rem;
    }
    .msg.user .msg-time { text-align: right; }

    /* ── Empty state ── */
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      min-height: 350px;
      text-align: center;
      padding: 3rem 2rem;
    }

    .empty-icon-wrap {
      width: 72px; height: 72px;
      background: var(--ivory);
      border: 1px solid rgba(139,168,136,0.4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      margin-bottom: 1.5rem;
      animation: floatIcon 4s ease-in-out infinite;
    }
    @keyframes floatIcon {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .empty-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.9rem;
      font-weight: 400;
      color: var(--green);
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .empty-sub {
      font-size: 0.88rem;
      color: var(--text-light);
      font-weight: 300;
      line-height: 1.6;
    }

    /* ── Typing indicator ── */
    .typing-indicator {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
      margin-bottom: 1.75rem;
      display: none;
    }

    .typing-avatar {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: var(--ivory-dark);
      border: 1px solid rgba(139,168,136,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
    }

    .typing-bubble {
      background: var(--ivory);
      border: 1px solid rgba(139,168,136,0.3);
      border-radius: 12px;
      border-bottom-left-radius: 3px;
      padding: 0.9rem 1.2rem;
      display: flex;
      gap: 4px;
      align-items: center;
    }
    .typing-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--sage);
      animation: typingBounce 1.4s ease infinite;
    }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingBounce {
      0%,60%,100% { transform: translateY(0); }
      30% { transform: translateY(-5px); }
    }

    /* ── Input area ── */
    .input-area {
      background: var(--white);
      border: 1px solid rgba(139,168,136,0.35);
      border-radius: 10px;
      padding: 1rem 1.2rem;
    }

    .input-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .msg-input {
      flex: 1;
      background: var(--ivory);
      border: 1.5px solid rgba(139,168,136,0.35);
      border-radius: 8px;
      padding: 0.85rem 1.1rem;
      font-size: 0.93rem;
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      resize: none;
    }
    .msg-input:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(45,80,22,0.08);
      background: var(--white);
    }
    .msg-input::placeholder { color: rgba(90,107,82,0.4); }

    .send-btn {
      width: 44px; height: 44px;
      background: var(--green);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .send-btn:hover { background: var(--green-light); transform: scale(1.05); }
    .send-btn:active { transform: scale(0.97); }
    .send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .send-icon {
      width: 18px; height: 18px;
      fill: none;
      stroke: var(--ivory);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .input-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 0.6rem;
      padding: 0 0.2rem;
    }
    .input-hint {
      font-size: 0.7rem;
      color: rgba(90,107,82,0.5);
      font-family: 'DM Mono', monospace;
    }
    .char-count {
      font-size: 0.7rem;
      color: rgba(90,107,82,0.5);
      font-family: 'DM Mono', monospace;
    }

    @media (max-width: 860px) {
      .sidebar { display: none; }
      .chat-layout { padding: 1rem; }
      .topbar { padding: 0 1rem; }
      .topbar-title { font-size: 1.1rem; }
      .chat-id-badge { display: none; }
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <nav class="topbar">
    <div class="topbar-left">
      <div class="topbar-logo">💭</div>
      <span class="topbar-title">Conversation</span>
      <% if (chatId && chatId !== '') { %>
        <div class="topbar-sep"></div>
        <span class="chat-id-badge">#<%= chatId.substring(0, 8) %></span>
      <% } %>
    </div>
    <div class="topbar-actions">
      <a href="/chat" class="nav-btn nav-btn-primary">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New
      </a>
      <a href="/history" class="nav-btn nav-btn-ghost">History</a>
      <form action="/logout" method="POST" style="display:inline">
        <button type="submit" class="nav-btn nav-btn-ghost">Logout</button>
      </form>
    </div>
  </nav>

  <!-- MAIN LAYOUT -->
  <div class="chat-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-card">
        <p class="sidebar-card-label">Quick start</p>
        <button class="prompt-chip" onclick="fillMessage('I need help deciding on a career change')">💼 Career path advice</button>
        <button class="prompt-chip" onclick="fillMessage('Should I buy or rent a house?')">🏠 Housing decision</button>
        <button class="prompt-chip" onclick="fillMessage('Help me choose the right college major')">🎓 Education choice</button>
        <button class="prompt-chip" onclick="fillMessage('I am thinking about starting a business')">🚀 Starting a business</button>
      </div>

      <div class="sidebar-card">
        <p class="sidebar-card-label">How it works</p>
        <p class="sidebar-tip">Share what's weighing on you. Your AI companion will listen, ask the right questions, and help you find your own clarity.</p>
      </div>
    </aside>

    <!-- CHAT MAIN -->
    <div class="chat-main">
      <div class="messages-panel">
        <div class="messages-scroll" id="messagesScroll">

          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(function(msg) { %>
              <div class="msg <%= msg.role %> <%= msg.isError ? 'error' : '' %>">
                <div class="msg-row">
                  <div class="msg-avatar">
                    <%= msg.role === 'user' ? '👤' : '🌿' %>
                  </div>
                  <div class="msg-bubble">
                    <%= msg.text %>
                  </div>
                </div>
                <div class="msg-time"><%= msg.timestamp || '' %></div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-icon-wrap">🧭</div>
              <h2 class="empty-title">Begin Your Journey</h2>
              <p class="empty-sub">Share what's on your mind.<br>I'm here to help you find clarity.</p>
            </div>
          <% } %>

          <!-- Typing indicator -->
          <div class="typing-indicator" id="typingIndicator">
            <div class="typing-avatar">🌿</div>
            <div class="typing-bubble">
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- INPUT AREA -->
      <div class="input-area">
        <form id="chatForm" method="POST" action="/chat">
          <input type="hidden" name="chatId" value="<%= chatId || '' %>">
          <input type="hidden" name="messages" value='<%- JSON.stringify(messages || []) %>'>

          <div class="input-row">
            <input
              type="text"
              name="message"
              id="messageInput"
              class="msg-input"
              placeholder="Share your thoughts…"
              required
              autocomplete="off"
              maxlength="1000"
            >
            <button type="submit" class="send-btn" id="sendBtn">
              <svg class="send-icon" viewBox="0 0 24 24">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </div>
          <div class="input-footer">
            <span class="input-hint">Press Enter to send</span>
            <span class="char-count" id="charCount">0 / 1000</span>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    const scroll = document.getElementById('messagesScroll');
    const form = document.getElementById('chatForm');
    const input = document.getElementById('messageInput');
    const sendBtn = document.getElementById('sendBtn');
    const charCount = document.getElementById('charCount');
    const typingIndicator = document.getElementById('typingIndicator');

    // Scroll to bottom
    scroll.scrollTop = scroll.scrollHeight;

    // Character counter
    input.addEventListener('input', () => {
      charCount.textContent = `${input.value.length} / 1000`;
    });

    // Enter to submit
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (input.value.trim()) form.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });

    // Form submit
    form.addEventListener('submit', (e) => {
      const msg = input.value.trim();
      if (!msg) { e.preventDefault(); return; }
      sendBtn.disabled = true;
      typingIndicator.style.display = 'flex';
      scroll.scrollTop = scroll.scrollHeight;
    });

    // Suggestion chips
    function fillMessage(text) {
      input.value = text;
      input.focus();
      charCount.textContent = `${text.length} / 1000`;
    }

    input.focus();
  </script>
</body>
</html>
