<!DOCTYPE html>
<html>
<head>
  <title>Decision Chat</title>
</head>
<body>

<h2>💬 Decision Chat</h2>

<div>
  <% messages.forEach(m => { %>
    <p><strong><%= m.role %>:</strong> <%= m.text %></p>
  <% }) %>
</div>

<form method="POST" action="/chat">
  <input type="hidden" name="messages" value='<%= JSON.stringify(messages) %>'>
  <input type="text" name="message" placeholder="Ask anything..." required />
  <button type="submit">Send</button>
</form>

</body>
</html>
